input ../qc.cafe .
-- input ../qc1.0.11.cafe .

-- open GATE .

-- close

-- eof

open GATE .
    ops a b : -> Complex .

    -- vars BK BK1 BK2 BK3 : BasisKet .
    vars BK4 : BasisKet .
    vars KETPSI KET1 KET2 : Ket .
    vars C1 C2 : Complex .

    eq KETPSI = a * |0> + b * |1> .

    -- eq BK1 * BK2 * KET + BK3 * (BK4 * KET) = (BK1 * BK2 + BK3 * BK4) * KET .
    -- eq (BK1 * BK2) * KETPSI + (BK3 * BK4) * KETPSI = (BK1 * BK2 + BK3 * BK4) * KETPSI .
    eq a * (BK1 * (BK2 * BK3)) + b * (BK1 * (BK2 * BK4)) = BK1 * (BK2 * (a * BK3 + b * BK4)) .
    eq BK1 * (BK2 * KETPSI) + BK3 * (BK4 * KETPSI) = (BK1 * BK2 + BK3 * BK4) * KETPSI .
    eq (BK * BK1) * KETPSI + (BK * BK2) * KETPSI = (BK * (BK1 + BK2)) * KETPSI .
    -- eq (BK1 * KET) * KETPSI + (BK2 * KET) * KETPSI = ((BK1 + BK2) * KET) * KETPSI .
    -->
    --> Teleport (with measurement abstraction):
    red (C(0)Z(2))
        x (C(1)X(2))
        x (cos(1/4 pi) * (P0(1) + P1(1)))
        x (cos(1/4 pi) * (P0(0) + P1(0)))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x KETPSI * |0> * |0> .
    -->
    --> Teleport
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P0(0))
        x (P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x KETPSI * |0> * |0> .
    -- -->
    -- --> Teleport (with coefficient trick to run faster): BUT it's not faster
    -- red (cos(1/4 pi) * cos(1/4 pi)) * (
    --     C(0)Z(2)
    --     x C(1)X(2)
    --     x (P0(1) + P1(1))
    --     x (P0(0) + P1(0))
    --     x H(0) 
    --     x C(0)X(1)
    --     x C(1)X(2)
    --     x H(1)
    --     x KETPSI * |0> * |0>
    --  ) .
close

eof

-- Teleport (with measurement abstraction):
-- cos((1/4 pi))^4 = 0.25
-- 0.25 * (4 cases) = 1
(
    cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
        (
            (
                (a * (|0> * (|0> * |0>))) + (b * (|0> * (|0> * |1>)))
            ) + (
                (a * (|0> * (|1> * |0>))) + (b * (|0> * (|1> * |1>)))
            )
        ) + (
            (
                (a * (|1> * (|0> * |0>))) + (b * (|1> * (|0> * |1>)))
            ) + (
                (a * (|1> * (|1> * |0>))) + (b * (|1> * (|1> * |1>)))
            )
        )
    )
)))):Ket -- op getNthQubit : Ket -> Ket . ???

-- Teleport (with measurement abstraction and lemma):
(cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
    (
        (
            |0> * (|0> * ((a * |0>) + (b * |1>)))
        ) + (
            |0> * (|1> * ((a * |0>) + (b * |1>)))
        )
        ) + (
            (
                |1> * (|0> * ((a * |0>) + (b * |1>)))
            ) + (
                |1> * (|1> * ((a * |0>) + (b * |1>)))
            )
        )
))))):Ket

(cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
    (
        (|0> * (|0> + |1>)) * ((a * |0>) + (b * |1>))
    ) + (
        (|1> * (|0> + |1>)) * ((a * |0>) + (b * |1>))
    )
))))):Ket

-- (Normal) Teleport
(
    cos((1/4 pi)) * (cos((1/4 pi)) * (
        (
            a * (|0> * (|1> * |0>))
        ) + (
            b * (|0> * (|1> * |1>))
        )
    )
)):Ket

-- (Normal) Teleport with lemma
(cos((1/4 pi)) * (cos((1/4 pi)) * (
    |0> * (|1> * ((a * |0>) + (b * |1>)))
))):Ket



