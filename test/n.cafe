        (
            (a * (| a |^2)) * (|0> * (|0> * |0>))
        ) + (
            (a * ((a ^*) * b)) * (|0> * (|0> * |1>))
        )
    ) + (
            (
                (b * ((b ^*) * a)) * (|0> * (|0> * |0>))
        ) + (
            (b * (| b |^2)) * (|0> * (|0> * |1>))
        )
    )
):Ket