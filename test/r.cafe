input ../qc.cafe .

set trace off
set trace whole off
-- set trace on
-- set trace whole on

open REAL .
    red - cos(rzero) .
    red (cos((23/84 pi)) * cos((5/84 pi))) = rzero .
    red (cos((23/84 pi)) * cos((5/84 pi))) = rzero .
    red ((cos(rzero) + cos(rzero)) * (cos((23/84 pi)) * cos((5/84 pi)))) = rzero .
    red ((cos(rzero) + cos(rzero)) * (cos((23/84 pi)) * cos((5/84 pi)))) .
    red (cos((23/84 pi)) * cos((5/84 pi))) .
    red - cos((23/84 pi)) = cos((5/84 pi)) .
    red cos((5/84 pi)) = cos((5/84 pi)) .
close
set trace off
set trace whole off
-- eof

open REAL .
    --> TEST 1
    red (2 pi) - (1 pi) .
    -- red 2 pi - 1 pi . -- Will cause error
    red sin(5/8 pi) .
    red sin(1/2 pi) .
    red (8 pi) * cos(rzero) .
    red (8 pi) * cos(1 pi) .

    --> TEST 2
    red rzero = rzero .
    red rzero < rzero .
    red rzero < 1/2 pi .
    red rzero >  rzero .
    red rzero >= rzero .
    red rzero <  rzero .
    red rzero <= rzero .

    --> TEST 3
    red cos(1/2 pi) > rzero .
    red sin(1/2 pi) > rzero .
    red sin(3/2 pi) > rzero .
    red cos(rzero) > rzero .
    red sin(1/3 pi) > rzero .
    red sin(100/15 pi) > rzero .
    red - sin(1/2 pi) > rzero .
    red sin(1/3 pi) - sin(1/3 pi) > rzero .
    red sin(2 pi) + cos(1/2 pi) > rzero .
    red sin(2 pi) + cos(5/3 pi) > rzero .
    red 5/3 pi > 1 pi .
    red (2 pi) - (1 pi) >= rzero .
    -- red 2 pi - 1 pi >= rzero . -- Will cause error
    
    --> TEST 4
    --> Okay
    red cos(1/2 pi) = rzero .
    red sin(1/2 pi) = rzero .
    red sin(3/2 pi) = rzero .
    red cos(rzero) = rzero .
    red sin(1/3 pi) = rzero .
    red sin(100/15 pi) = rzero .
    red - sin(1/2 pi) = rzero .
    red sin(1/3 pi) - sin(1/3 pi) = rzero .
    red sin(2 pi) + cos(1/2 pi) = rzero .
    red sin(2 pi) + cos(5/3 pi) = rzero .
    red sin(2/7 pi) + cos(5/3 pi) .
    red sin(2/7 pi) + cos(5/3 pi) = rzero .
close
-- set trace on
set trace off
set trace whole off