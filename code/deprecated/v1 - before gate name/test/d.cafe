mod! FOO {
    pr(NAT)

    [Foo Name]

    ops A B C D : -> Name .
    op (_[_]) : Name Nat -> Foo .
    op (_[_,_]) : Name Nat Nat -> Foo .
    op _*_ : Foo Foo -> Foo {l-assoc} .
}
