input ../qc.cafe .

set trace on
set trace off

open COMPLEX .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C1: misc
    red 0 == 0.0 . -- gives false
    -- red 0 / 0 . -- gives error
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C2: _-_ (INT and FLOAT)
    -- red 1.0 - 2 .
    red (((1 - 2) - 3) + 4) .
    red 1 - 2 - 3 + 4 . -- Right associativity
    red 0 - 2.0 .
    red 1.0 - 2.0 .
    red 1.0 - 2.0 - 3.0 + 4.0 . -- gives error if FLOAT is imported before INT
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C3: -_
    red Im(5) - Im(8) - Im(10) .
    red Im(5) - - Im(8) - Im(10) .
    red - Im(5) + Re(8) - Im(10) .
    red - Im(5) + Re(8) - - Im(10) .
    red - Im(5) + Im(5) .
    red - Re(5) + Re(5) .
    red - Re(5) + Re(5) + Im(10) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C4: Re, Im with _+_
    red Im(5) + Im(8) + Re(100) + Im(100) .
    red Im(5) + Re(8) + Re(100) + Im(100) .
    red Re(5) + Im(8) + Re(100) + Im(100) .
    red Re(5) + Re(8) + Re(100) + Im(100) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C5: Re, Im with _-_
    red Im(5) - Im(8) - Re(100) - Im(100) .
    red Im(5) - Re(8) - Re(100) - Im(100) .
    red Re(5) - Im(8) - Re(100) - Im(100) .
    red Re(5) - Re(8) - Re(100) - Im(100) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C6: RE with _+_
    red RE(Im(5) + Im(8) + Re(100) + Im(100)) .
    red RE(Im(5) + Re(8) + Re(100) + Im(100)) .
    red RE(Re(5) + Im(8) + Re(100) + Im(100)) .
    red RE(Re(5) + Re(8) + Re(100) + Im(100)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C7: RE with _-_
    red RE(Im(5) - Im(8) - Re(100) - Im(100)) .
    red RE(Im(5) - Re(8) - Re(100) - Im(100)) .
    red RE(Re(5) - Im(8) - Re(100) - Im(100)) .
    red RE(Re(5) - Re(8) - Re(100) - Im(100)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C8: IM with _+_
    red IM(Im(5) + Im(8) + Re(100) + Im(100)) = 113.0 .
    red IM(Im(5) + Re(8) + Re(100) + Im(100)) = 105.0 .
    red IM(Re(5) + Im(8) + Re(100) + Im(100)) = 108.0 .
    red IM(Re(5) + Re(8) + Re(100) + Im(100)) = 100.0 .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C9: IM with _-_
    red IM(Im(5) - Im(8) - Re(100) - Im(100)) .
    red IM(Im(5) - Re(8) - Re(100) - Im(100)) .
    red IM(Re(5) - Im(8) - Re(100) - Im(100)) .
    red IM(Re(5) - Re(8) - Re(100) - Im(100)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C10: misc/debug
    red Re(5) - Im(15) - Re(10) + Im(20) .
    red Re(5) - Im(15) - (Re(10) + Im(20)) .
    red Re(5) - Im(15) - Re(10) + Im(20) .
    red Re(5) - Im(15) - (Re(10) + Im(20)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C11: RE and IM with mixed _+_ and _-_
    red RE(Re(5) - Im(15) - Re(10) + Im(20)) .
    red RE(Re(5) - Im(15) - (Re(10) + Im(20))) .
    red IM(Re(5) - Im(15) - Re(10) + Im(20)) .
    red IM(Re(5) - Im(15) - (Re(10) + Im(20))) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C12: _*_
    red Re(10) * Re(2) .
    red Re(10) * Im(2) .
    red Im(10) * Re(2) .
    red Im(10) * Im(2) .
    --> 
    red Re(- 10) * Re(2) .
    red Re(- 10) * Im(2) .
    red Im(- 10) * Re(2) .
    red Im(- 10) * Im(2) .
    --> 
    red (Re(5) + Im(10)) * Re(2) .
    red (Re(5) + Im(10)) * Im(2) .
    red (Re(5) + Im(10)) * (Re(2) + Im(20)) .
    red (Im(10) + Re(5)) * (Re(2) + Im(20)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C13: _/_
    red Re(10) / Re(2) .
    red Re(10) / Im(2) .
    red Im(10) / Re(2) .
    red Im(10) / Im(2) .
    --> 
    red Re(- 10) / Re(2) .
    red Re(- 10) / Im(2) .
    red Im(- 10) / Re(2) .
    red Im(- 10) / Im(2) .
    --> 
    red (Re(5) + Im(10)) / Re(2) .
    red (Re(5) + Im(10)) / Im(2) .
    red (Re(5) + Im(10)) / (Re(2) + Im(20)) .
    red (Im(10) + Re(5)) / (Re(2) + Im(20)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C14: sqrt
    red sqrt(Re(-1)) .
    red sqrt(Re(-1.0)) .
    red sqrt(Re(-4.0)) .
    red sqrt(Re(-4.0) * Re(-4.0)) .
    red sqrt(Im(-4.0) * Im(-4.0)) .
    red sqrt((Re(-4.0) + Im(-8.0)) * (Re(-4.0) + Im(-8.0))) . -- Won't completely be reduced
    red sqrt((Re(-4.0) + Im(-8.0)) * (Re(10) + Im(20))) . -- Won't completely be reduced
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST C15: conj
    red conj(Im(10)) .
    red conj(Re(10)) .
    red conj(Re(20) + Im(10)) .
    red conj(Re(20) - Im(10)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
close
set trace off