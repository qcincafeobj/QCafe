-- eof

mod! SIMPLIFIER {
    pr(N-HOP-VERIFIER)

    op teleport-simplfr : -> Simplifer .
    op getKthQubit : Nat Ket -> Ket .
    
    vars KET KET1 KET2 : Ket .
    vars KPROG KPROG1 KPROG2 : KetProgram .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C : Complex .
    vars SMPLFR : Simplifer .
    
    eq SMPLFR[KPROG1 U KPROG2] = SMPLFR[KPROG1] U SMPLFR[KPROG2] .

    eq teleport-simplfr[state: KET;] = state: getKthQubit(2, KET); .
    
    eq getKthQubit(N, KET1 + KET2) = getKthQubit(N, KET1) + getKthQubit(N, KET2) .
    eq getKthQubit(NzN, BK @ KET)  = getKthQubit(p NzN, KET) .
    eq getKthQubit(0, BK @ KET)    = BK .
    eq getKthQubit(0, BK)          = BK .
    eq getKthQubit(N, C * KET)     = C * getKthQubit(N, KET) .
}

open SIMPLIFIER .
    op teleport-prog : -> Program .
    op ketpsi : -> Ket .
    
    ops a b : -> Complex .

    eq ketpsi = (a * |0> + b * |1>) @ |0> @ |0> .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) .

    -- reverse the order (???)
    eq teleport-prog = (
        if measure(0) then Z(2) else skip;
    
        if measure(1) then {X(2);} else {skip;}
    
        H(0) x C X ( 0 , 1 ); C X ( 1 , 2 ) x H(1);
    ) .
    
    red teleport-prog .
    red verify(teleport-prog, teleport-simplfr, state: ketpsi;) .
    red n-hop-verify(teleport-prog, teleport-simplfr, state: ketpsi;) .
close

eof
(
    teleport-simplfr [
        (
            (
                state: ((b * (|1> @ (|0> @ |1>))) + (a * (|1> @ (|0> @ |0>)))) ;
            ) U (
                (state: ((b * (|0> @ (|0> @ |1>))) + (a * (|0> @ (|0> @ |0>)))) ;) U ((state: ((b * (|0> @ (|1> @ |1>))) + (a * (|0> @ (|1> @ |0>)))) ;) U (state: ((b * (|1> @ (|1> @ |1>))) + (a * (|1> @ (|1> @ |0>)))) ;))
            )
        ) 
    ]
):?Program