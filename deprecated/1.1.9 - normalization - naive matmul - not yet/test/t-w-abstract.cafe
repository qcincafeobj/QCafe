open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    -- eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    -- eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    -- eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .
    
    --> Case 1.1
    --> Teleport P0(0), P0(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P0(0))
        x msment-op(P0(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 1.2
    --> Teleport P0(0), P1(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P0(0))
        x msment-op(P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 1.3
    --> Teleport P1(0), P0(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P1(0))
        x msment-op(P0(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 1.4
    --> Teleport P1(0), P1(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P1(0))
        x msment-op(P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 2.1
    --> Teleport P0(1), P0(0)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P0(1))
        x msment-op(P0(0))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 2.2
    --> Teleport P0(1), P1(0)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P0(1))
        x msment-op(P1(0))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 2.3
    --> Teleport P1(1), P0(0)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P1(1))
        x msment-op(P0(0))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    --> Case 2.4
    --> Teleport P1(1), P1(0)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P1(1))
        x msment-op(P1(0))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    -->
    --> Teleport (with measurement abstraction):
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(cos(1/3 pi) * (P0(1) + P1(1)))
        x msment-op(cos(1/3 pi) * (P0(0) + P1(0)))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    -- Normalize after measurement
    -- Checking:
    -- I * I * |psi><psi| x output

    -- Grouping M1 x K1 and M2 x K2 as M1 x K1 + M2 x K2
    -- is okay in general, I think, because:
        -- M1 x (a * K1) = a * (M1 x K1)
        -- M2 x (b * K2) = b * (M2 x K2)
        -- M1 x (a * K1) + M2 x (b * K2) = a * (M1 x K1) + b * (M2 x K2)
        
        -- M1 x (c * K1) (x) K2 = c * (M1 x (K1 (x) K2))
        -- M2 x (c * K3) (x) K4 = c * (M2 x (K3 (x) K4))
        -- [M1 x (c * K1) (x) K2] + [M2 x (c * K3) (x) K4] = c * [(M1 x (K1 (x) K2) + (M2 x (K3 (x) K4))]
    
    -- Summing side-by-side doesn't make the coefficients
    -- become confusing
    -- If it were confusing, it should be confusing from the start
    -- when we isolate the coefficient similar to the case of "c".
    -- Right from: c * (M1 x (K1 (x) K2))
    -- We don't even know c is for K1 or K2

close

eof
(
    (
        (
            (
                cos((1/4 pi)) * (cos((1/4 pi)) * ((cos((1/4 pi)) * cos((1/4 pi))) * (
                    a * (|0> * (|0> * |0>))
                )))
            ) + (
                cos((1/4 pi)) * (cos((1/4 pi)) * ((cos((1/4 pi)) * cos((1/4 pi))) * (
                    a * (|0> * (|1> * |0>))
                )))
            )
        ) + (
            (
                cos((1/4 pi)) * (cos((1/4 pi)) * ((cos((1/4 pi)) * cos((1/4 pi))) * (
