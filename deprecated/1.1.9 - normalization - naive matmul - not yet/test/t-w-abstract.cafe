                )))
            ) + (
                cos((1/4 pi)) * (cos((1/4 pi)) * ((cos((1/4 pi)) * cos((1/4 pi))) * (
                    a * (|1> * (|1> * |0>))
            )))))) + (((cos((1/4 pi)) * (cos((1/4 pi)) * (((cos((1/4 pi)) * cos((1/4 pi))) * b) * (|0> * (|0> * |1>))))) + (cos((1/4 pi)) * (cos((1/4 pi)) * (((cos((1/4 pi)) * cos((1/4 pi))) * b) * (|0> * (|1> * |1>)))))) + ((cos((1/4 pi)) * cos((1/4 pi))) * ((cos((1/4 pi)) * cos((1/4 pi))) * ((b * (|1> * (|0> * |1>))) + (b * (|1> * (|1> * |1>)))))))):Ket
(
    (
        cos(rzero) / (
            cos((1/4 pi)) * cos((1/4 pi))
        )
    ) * (
        (cos((1/4 pi)) * cos((1/4 pi))) * (
            |0> * (|1> * ((a * |0>) + (b * |1>)))
        )
    )
):Ket

((((|0> x <0|) * I) + ((I(2) * (((|0> x <0|) * I) + ((- (|1> x <1|)) * I))) x ((|1> x <1|) * I))) x (((I(1) * ((|0> x <0|) * I)) + ((I(2) * (((|0> x <1|) * I) + ((|1> x <0|) * I))) x (I(1) * ((|1> x <1|) * I)))) x (
    msment-op(((|0> x <0|) * I)) x (
        msment-op((I(1) * ((|1> x <1|) * I))) x (((cos((1/4 pi)) * ((a * (cos((1/4 pi)) * (|0> * (|0> * |0>)))) + (a * (cos((1/4 pi)) * (|1> * (|0> * |0>)))))) + (cos((1/4 pi)) * ((a * (cos((1/4 pi)) * (|0> * (|1> * |1>)))) + (a * (cos((1/4 pi)) * (|1> * (|1> * |1>))))))) + ((cos((1/4 pi)) * ((b * (cos((1/4 pi)) * (|0> * (|1> * |0>)))) + (b * (cos((3/4 pi)) * (|1> * (|1> * |0>)))))) + (cos((1/4 pi)) * ((b * (cos((1/4 pi)) * (|0> * (|0> * |1>)))) + (b * (cos((3/4 pi)) * (|1> * (|0> * |1>)))))))))))):?Vect

--> Teleport:
(
    (
        cos((1/4 pi)) * (
            a * (cos((1/4 pi)) * (
                |0> * (|1> * |0>)
            ))
        )
    ) + (
        cos((1/4 pi)) * (
            b * (cos((1/4 pi)) * (
                    |0> * (|1> * |1>)
            ))
        )
    )
):Ket

--> Teleport (with measurement abstraction):
(
    (
        (
            (
                cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
                    a * (cos((1/4 pi)) * (
                        |0> * (|0> * |0>)
