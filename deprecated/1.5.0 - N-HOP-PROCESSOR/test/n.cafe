input ../qc.cafe .

-- open GATE .
--     op ketpsi : -> Ket .
--     ops a1 a2 a3 a4 : -> Complex .
--     eq (a1 ^*) * a1 + (a2 ^*) * a2 + (a3 ^*) * a3 + (a4 ^*) * a4 = cos(rzero) .
--     eq ketpsi = a1 * |0> @ |0> + a2 * |0> @ |1> + a3 * |1> @ |0> + a4 * |1> @ |1> .
--     red (cos(rzero) / || ketpsi ||^2) * ketpsi .
--     red (cos(rzero) / || a1 * |0> ||^2) * (a1 * |0>) .
--     red normalizer x ketpsi .
-- close

-- eof

-- open QUANTUM-INTERPRETER .
--     red |0>; X(0) .
-- close

-- eof

-- set print mode fancy
-- set print mode tree
-- set print mode s-expr
set print mode normal

mod! N-HOP-TELEPORT {
    pr(N-HOP-PROCESSOR)

    op teleport-pre-processor : -> Preprocessor .
    op teleport-post-processor : -> Postprocessor .
    op teleport-program : -> Statement .
    op getKthQubit : Nat Ket -> Ket .
    
    vars KET KET1 KET2 : Ket .
    vars KSTMNT KSTMNT1 KSTMNT2 : KetStatement .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C : Complex .
    

    eq teleport-pre-processor[KET]  = KET @ |0> @ |0> .
    eq teleport-post-processor[KET] = getKthQubit(2, KET) .

    eq teleport-post-processor[KSTMNT1 U KSTMNT2] = (
        teleport-post-processor[KSTMNT1] U teleport-post-processor[KSTMNT2]
    ) .
    
    eq getKthQubit(N, KET1 + KET2) = getKthQubit(N, KET1) + getKthQubit(N, KET2) .
    eq getKthQubit(NzN, BK @ KET)  = getKthQubit(p NzN, KET) .
    eq getKthQubit(0, BK @ KET)    = BK .
    eq getKthQubit(0, BK)          = BK .
    eq getKthQubit(N, C * KET)     = C * getKthQubit(N, KET) .

    eq teleport-program = (
        H(1);
        C X ( 1 , 2 ) ;  
        C X ( 0 , 1 ) ; 
        H(0) ; 
        if M(1) then X(2) else skip endif;
        if M(0) then Z(2) else skip endif
    ) .
}

open N-HOP-TELEPORT .
    op ketpsi : -> Ket .
    ops a b : -> Complex .

    eq ketpsi = (a * |0> + b * |1>) .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) .


    --> Proof of
    --> run-n-hop(N, KSTMNT, teleport-program, PRE, POST)
    --> by structural induction on N

    -->
    --> Base case: N = 0 (i.e teleport from the (0 + 1) = 1st hop to its next hop)
    --> w2s: run-n-hop(0, auxiliary constants) = ketpsi
    op base-case : -> KetStatement .

    eq base-case = run-n-hop(
        0,
        ketpsi,
        teleport-program,
        teleport-pre-processor,
        teleport-post-processor
    ) .

    red base-case .

    -->
    --> Induction case:
    --> fc: (n):Nat
    --> IH: run-n-hop(n, auxiliary constants) = ketpsi
    --> w2s: run-n-hop(n + 1, auxiliary constants) = ketpsi
    op n : -> Nat .
    -- IH
    eq run-n-hop(
        n,
        ketpsi,
        teleport-program,
        teleport-pre-processor,
        teleport-post-processor
    ) = ketpsi .
    eq p (1 + n) = n .
    red run-n-hop(
        n + 1,
        ketpsi,
        teleport-program,
        teleport-pre-processor,
        teleport-post-processor
    ) = ketpsi .
close

eof

(
    run-n-hop(
        (p (s n)),
        ((a * |0>) + (b * |1>)),
        (((((I(1) @ (cos((1/4 pi)) * (((- cos(rzero)) * ((|1> x <1|) @ I)) + (((|0> x <0|) @ I) + (((|0> x <1|) @ I) + ((|1> x <0|) @ I)))))) ; (((I(2) @ (((|1> x <0|) @ I) + ((|0> x <1|) @ I))) x (I(1) @ ((|1> x <1|) @ I))) + (I(1) @ ((|0> x <0|) @ I)))) ; ((((I(1) @ (((|1> x <0|) @ I) + ((|0> x <1|) @ I))) x ((|1> x <1|) @ I)) + ((|0> x <0|) @ I)) ; (cos((1/4 pi)) * (((|0> x <0|) @ I) + (((|1> x <0|) @ I) + (((|0> x <1|) @ I) + ((- cos(rzero)) * ((|1> x <1|) @ I)))))))) ; (((I(1) @ ((|0> x <0|) @ I)) ; normalizer) U (((I(1) @ ((|1> x <1|) @ I)) ; normalizer) ; (I(2) @ (((|1> x <0|) @ I) + ((|0> x <1|) @ I)))))) ; ((((|0> x <0|) @ I) ; normalizer) U ((((|1> x <1|) @ I) ; normalizer) ; (I(2) @ (((- cos(rzero)) * ((|1> x <1|) @ I)) + ((|0> x <0|) @ I)))))),
        teleport-pre-processor,
        teleport-post-processor
    ) = ((b * |1>) + (a * |0>))
):Bool

(
    getKthQubit(
        2,
        (
            (
                (a * (|1> @ (|0> @ |0>))) + (b * (|1> @ (|0> @ |1>)))
            ) U (
                (
                    (b * (|0> @ (|1> @ |1>))) + (a * (|0> @ (|1> @ |0>)))
                ) U (
                    (
                        (a * (|1> @ (|1> @ |0>))) + (b * (|1> @ (|1> @ |1>)))
                    ) U (
                        (b * (|0> @ (|0> @ |1>))) + (a * (|0> @ (|0> @ |0>)))
                    )
                )
            )
        )
    )
):?Statement