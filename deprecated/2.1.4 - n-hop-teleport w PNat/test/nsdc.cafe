input ../qc.cafe .

-- set print mode fancy
-- set print mode tree
-- set print mode s-expr
set print mode normal

mod! N-HOP-SUPER-DENSE-CODING {
    pr(PNAT)
    pr(QUANTUM-INTERPRETER)

    op sdc-pre-processor : -> Statement .
    op sdc-post-processor : -> Statement .
    op sdc-program : -> Statement .

    op getKthQubit : Nat Ket -> Ket .
    
    op n-hop-sdc : PNat KetSet -> KetSet .

    op classical-state : -> Ket .
    ops bk1 bk2 : -> BasisKet .

    vars KET KET1 KET2 : Ket .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK BK1 BK2 : BasisKet .
    vars C : Complex .
    vars KSET : KetSet .
    vars PN : PNat .

    eq classical-state = (bk1 @ bk2) .

    eq execute(sdc-pre-processor , {BK1 @ BK2}) = {BK1 @ BK2 @ |0> @ |0>} .
    eq execute(sdc-post-processor, {KET}) = {getKthQubit(2, KET) @ getKthQubit(3, KET)} .

    eq getKthQubit(N, KET1 + KET2) = getKthQubit(N, KET1) + getKthQubit(N, KET2) .
    eq getKthQubit(NzN, BK @ KET)  = getKthQubit(p NzN, KET) .
    eq getKthQubit(0, BK @ KET)    = BK .
    eq getKthQubit(0, BK)          = BK .
    eq getKthQubit(N, C * KET)     = C * getKthQubit(N, KET) .

    eq sdc-program = (
        sdc-pre-processor;
        H(2);
        C X ( 2 , 3 ) ;  
        if M(1) then X(2) else skip endif;
        if M(0) then Z(2) else skip endif;
        C X ( 2 , 3 ) ; 
        H(2) ; 
        sdc-post-processor
    ) .

    eq n-hop-sdc(0, KSET) = execute(sdc-program, KSET) .
    eq n-hop-sdc(s(PN), KSET) = execute(
        sdc-program,
        n-hop-sdc(PN, KSET)
    ) .
}

--> ==========================================================================================
--> Proof of
--> (∀NzN:NzNat) n-hop-sdc(NzN, {KET}) = {KET}
--> by structural induction on NzN
--> (NzN is the number of sdcations)
--> ------------------------------------------------------------------------------------------
--> Base case:
--> w2s: n-hop-sdc(1, {ketpsi}) = {ketpsi}
open N-HOP-TELEPORT .
    -- w2s
    red n-hop-sdc(0, {ketpsi}) = {ketpsi} .
close
--> ------------------------------------------------------------------------------------------
--> Induction case: 
--> fc : (nzn):NzNat
--> IH : n-hop-sdc(nzn, {a * |0> + b * |1>}) = {ketpsi}
--> w2s: n-hop-sdc(nzn + 1, {ketpsi}) = {ketpsi}
open N-HOP-TELEPORT .
    -- fc
    op pn : -> PNat .

    -- IH
    eq [IH] : n-hop-sdc(pn, {bk1 @ bk2}) = {classical-state} .   -- work
    -- eq [flawed-IH] : n-hop-sdc(n, {ketpsi}) = {ketpsi} .      -- won't work

    -- w2s
    --> w2s version 1
    red n-hop-sdc(s(pn), {bk1 @ bk2}) = {classical-state} .     -- work
    --> w2s version 2
    red n-hop-sdc(s(pn), {bk1 @ bk2}) = {classical-state} .                -- work
close
--> ==========================================================================================