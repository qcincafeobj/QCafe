mod! SIMPLIFIER {
    pr(N-HOP-VERIFIER)

    op teleport-simplfr : -> Simplifer .
    op getKthQubit : Nat Ket -> Ket .
    
    vars KET KET1 KET2 : Ket .
    vars KPROG KPROG1 KPROG2 : KetProgram .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C : Complex .
    vars SMPLFR : Simplifer .
    
    eq SMPLFR[KPROG1 U KPROG2] = SMPLFR[KPROG1] U SMPLFR[KPROG2] .

    eq teleport-simplfr[state: KET;] = state: getKthQubit(2, KET); .
    
    eq getKthQubit(N, KET1 + KET2) = getKthQubit(N, KET1) + getKthQubit(N, KET2) .
    eq getKthQubit(NzN, BK @ KET)  = getKthQubit(p NzN, KET) .
    eq getKthQubit(0, BK @ KET)    = BK .
    eq getKthQubit(0, BK)          = BK .
    eq getKthQubit(N, C * KET)     = C * getKthQubit(N, KET) .
}

open SIMPLIFIER .
    op teleport-prog : -> Program .
    op ketpsi : -> Ket .
    op initketpsi : -> Ket .
    op initstate : -> KetProgram .
    
    ops a b : -> Complex .

    eq ketpsi = (a * |0> + b * |1>) .
    eq initketpsi = ketpsi @ |0> @ |0> .
    eq initstate = state: initketpsi; .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) .

    -- -- reverse the order (???)
    -- eq teleport-prog = (
    --     H(1); C X ( 1 , 2 ); C X ( 0 , 1 ); H(0);

    --     if measure(1) then {X(2);} else {skip;}
    --     if measure(0) then {Z(2);} else {skip;}
        
    -- ) .
    
    eq teleport-prog = (
        if measure(0) then {Z(2);} else {skip;}
        if measure(1) then {X(2);} else {skip;}
        H(0) x C X ( 0 , 1 ) x C X ( 1 , 2 ) x  H(1);
    ) .
    red cos((1/4 pi)) / cos((1/4 pi)) .
    -- red teleport-prog .
    -- red (state: |0>;) = (state: |0>;) .
    red verify(teleport-prog, teleport-simplfr, state: initketpsi;) .
    red verify(
        teleport-prog, teleport-simplfr, state: initketpsi;
    ) = (state: ketpsi;) .
    -- red teleport-simplfr[verify(teleport-prog, state: ketpsi;)] .
    red initstate = teleport-simplfr[teleport-prog teleport-simplfr[teleport-prog initstate]] .
    red n-hop-verify(0, teleport-prog, teleport-simplfr, state: ketpsi;) .
    -- red n-hop-verify(0, teleport-prog, teleport-simplfr, state: ketpsi;) .

    -- red (
    --     verify(teleport-prog, teleport-simplfr, state: ketpsi;) = (state: ketpsi;)
    -- ) implies (
    --     verify(
    --         teleport-prog, 
    --         teleport-simplfr, 
    --         verify(teleport-prog, teleport-simplfr, state: initketpsi;)
    --     ) = (state: ketpsi;)
    -- ) .
close

eof
(state: (
    (
        (
            (cos((1/4 pi)) * (cos((1/4 pi)) * a)) / (
                (
                    cos((1/4 pi)) * (
                        cos((1/4 pi)) * (
                            cos((1/4 pi)) * (cos((1/4 pi)) * sqrt(2))
                        )
                    )
                ) / (
                    cos((1/4 pi)) * (cos((1/4 pi)) * sqrt(2))
                )
            )
        ) * |0>
    ) + (((cos((1/4 pi)) * (cos((1/4 pi)) * b)) / ((cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * sqrt(2))))) / (cos((1/4 pi)) * (cos((1/4 pi)) * sqrt(2))))) * |1>)) ;):KetProgram
(
    (
        state: (
            (
                (
                    (2 * (cos((1/4 pi)) * (cos((1/4 pi)) * a))) / (
                        sqrt((a ^*)) * sqrt(a))
                ) * |0>
            ) + (
                (
                    (
                        (cos((1/4 pi)) * (cos((1/4 pi)) * a)) / (sqrt(a) * sqrt((a ^*)))
                    ) + (
                        - ((cos((1/4 pi)) * (cos((1/4 pi)) * a)) / (sqrt(a) * sqrt((a ^*))))
                    )
                ) * |1>
            )
        ) ;
    ) U (
        state: (
            (
                (
                    (2 * (cos((1/4 pi)) * (cos((1/4 pi)) * b))) / (sqrt(b) * sqrt((b ^*)))) * |0>) + (((- ((cos((1/4 pi)) * (cos((1/4 pi)) * b)) / (sqrt((b ^*)) * sqrt(b)))) + ((cos((1/4 pi)) * (cos((1/4 pi)) * b)) / (sqrt((b ^*)) * sqrt(b)))) * |1>)) ;)):KetProgram