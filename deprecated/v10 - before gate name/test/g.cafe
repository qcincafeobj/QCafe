input ../qc.cafe .

-- -- open SQRT .
-- -- open GATE .
open GATE .
    red X(5) .
    red C(2)X(5) .
    red C(8)C(2)X(5) .
    red C(3)C(2)X(5) .
close

eof

open DISPLAY .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 1: misc/debug
    red p (0:Nat) .     -- (p 0:Nat):?FindResult+Float
    red p (5 + 10) .    -- 14
    red 1 = 1 .         -- true
    red 1 = 2 .         -- (1 = 2):Bool
    red 1 == 2 .        -- false
    red 1 > 0 .         -- true
    red 0 = 0 .
    -->
    red sd(1, 2) > 0 .
    red sd(2, 1) > 0 .
    red length("123") .
    red p (sd(nqubits(ket("0101")), 2)) .
    -->
    red nqubits(ket("")) .
    red ncols(I(8)) .
    red nrows(ket("01")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 2: tenprod
    red tenprod(ket("11"), ket("101")) .
    red tenprod(bra("11"), ket("101")) .
    red tenprod(ket("100001"), ket("123")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 3: matmul
    red matmul(I(4), ket("01")) .
    red matmul(I(8), ket("01")) .
    
    red matmul(bra("01"), I(4)) .
    red matmul(bra("01"), I(8)) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 4: outprod
    red outprod("1", "0") .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 5: X gate
    red tidx(sd(1, 1)) .
    red X[tidx(sd(1, 1))] .
    red tenprod(I(2), X[tidx(sd(1, 1))]) .
    red ncols(X[tidx(5)]) .
    -->
    red X[tidx(0)] .
    red X[tidx(1)] .
    red X[tidx(2)] .
    -->
    red ncols(X[tidx(2)]) .
    -->
    red tenprod(X[tidx(3)], X[tidx(5)]) . -- Just to see what will happen, I don't think this is a meaningful operation in theory
    -->
    red apply(X[tidx(-1)], ket("01")) . -- Not implemented
    red apply(X[tidx(0)], ket("01")) .
    red apply(X[tidx(5)], ket("01")) .
    red apply(X[tidx(2)], ket("011101")) .
    red apply(X[tidx(5)], ket("011101")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 6: Y gate
    red outprod("0", "1") .
    red Im(-1) * ket("1") .
    red Im(-1) * matmul(ket("0"),bra("1")) .
    red Im(-1) * outprod("0", "1") .
    red Im(-1) * outprod("0", "1") + outprod("0", "1") .
    -->
    red Y[tidx(0)] .
    red Y[tidx(1)] .
    red Y[tidx(2)] .
    -->
    red tenprod(Y[tidx(3)], Y[tidx(5)]) . -- Just to see what will happen, I don't think this is a meaningful operation in theory
    -->
    red apply(Y[tidx(-1)], ket("01")) . -- Not implemented
    red apply(Y[tidx(0)], ket("01")) .
    red apply(Y[tidx(5)], ket("01")) .
    red apply(Y[tidx(2)], ket("011101")) .
    red apply(Y[tidx(5)], ket("011101")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 7: Z gate
    red Z[tidx(0)] .
    red Z[tidx(1)] .
    red Z[tidx(2)] .
    -->
    red tenprod(Z[tidx(3)], Z[tidx(5)]) . -- Just to see what will happen, I don't think this is a meaningful operation in theory
    -->
    red apply(Z[tidx(-1)], ket("01")) . -- Not implemented
    red apply(Z[tidx(0)], ket("01")) .
    red apply(Z[tidx(5)], ket("01")) .
    red apply(Z[tidx(2)], ket("011101")) .
    red apply(Z[tidx(5)], ket("011101")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 8: H gate
    red H[tidx(0)] .
    red H[tidx(1)] .
    red H[tidx(2)] .
    -->
    red tenprod(H[tidx(3)], H[tidx(5)]) . -- Just to see what will happen, I don't think this is a meaningful operation in theory
    -->
    red apply(H[tidx(-1)], ket("01")) . -- Not implemented
    red apply(H[tidx(0)], ket("01")) .
    red apply(H[tidx(5)], ket("01")) .
    red apply(H[tidx(2)], ket("011101")) .
    red apply(H[tidx(5)], ket("011101")) .
    -- --> ----------------------------------------------------
    -- --> ----------------------------------------------------
    --> TEST 9: Ctrl(X) gate
    red (X[tidx(0)]) - I(2) . -- works well without {prec: <= _-_} on _[_]
    red X[tidx(0)] - I(2) . -- gives error if _[_] is not set to {prec: <= _-_}
    red cidx(1) .
    red tidx(2) .
    -- -->
    red ncols(Ctrl(X)[cidx(0) tidx(1)]) .
    red ncols(Ctrl(X)[cidx(1) tidx(2)]) .
    red ncols(Ctrl(X)[cidx(2) tidx(3)]) .
    -- -->
    red Ctrl(X)[cidx(0) tidx(1)] .
    red Ctrl(X)[cidx(1) tidx(2)] .
    red Ctrl(X)[cidx(2) tidx(3)] .
    -- -- -->
    -- -- red tenprod(H(tidx(3)), H(tidx(5))) . -- Just to see what will happen, I don't think this is a meaningful operation in theory
    -- -- -->
    -- -- red apply(H(tidx(-1)), ket("01")) . -- Not implemented
    -- -- red apply(H(tidx(0)), ket("01")) .
    -- -- red apply(H(tidx(5)), ket("01")) .
    -- -- red apply(H(tidx(5)), ket("011101")) .
    -- --> ----------------------------------------------------
    -- --> ----------------------------------------------------
    -->
    red apply(Ctrl(X)[cidx(2) tidx(0)], ket("0100")) . -- Ctrl(X) might look weird if it is not used with apply
    red display(apply(Ctrl(X)[cidx(2) tidx(0)], ket("0100"))) . -- Ctrl(X) might look weird if it is not used with apply
    --> TEST 10: display
    red int2str(0 - 100) .
    red display(X[tidx(2)]) .
    red display(Ctrl(X)[cidx(0) tidx(2)]) . -- Ctrl(X) might look weird if it is not used with apply
    red display(Ctrl(X)[cidx(2) tidx(0)]) . -- Ctrl(X) might look weird if it is not used with apply
    red display(Ctrl(X)[cidx(2) tidx(3)]) . -- Ctrl(X) might look weird if it is not used with apply
    red display(Ctrl(X)[cidx(3) tidx(2)]) . -- Ctrl(X) might look weird if it is not used with apply

close

eof

(
    display(
        tenprod(
            I(4),(matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
        )
    )
):String


tenprod(X(tidx(3)), X(tidx(5))) = (
    tenprod(
        tenprod(
            tenprod(
                I(8),
                (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
            ),
            I(32)
        ),
        (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
    )
):Mat

(Im(-1) * outprod("0","1")) + outprod("0","1") = (
    (
        Im(-1) * matmul(ket("0"),bra("1"))
    ) + matmul(ket("0"),bra("1"))
):Mat

apply(Y(tidx(5)),ket("011101")) = (
    matmul(
        tenprod(
            I(32),
            ((Im(-1) * matmul(ket("0"),bra("1"))) + (Im(1) * matmul(ket("1"),bra("0"))))
        ),
        ket("011101")
    )
):Mat