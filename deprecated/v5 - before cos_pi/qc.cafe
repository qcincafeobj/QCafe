mod! DIRACBASIS {
    [BasisBraVec < BraVec]
    [BasisKetVec < KetVec]
    [BraVec KetVec < Vect]

    [BasisBraKet < BraKet]

    ops <0| <1| : -> BasisBraVec .
    ops |1> |0> : -> BasisKetVec .
    ops |0><0| |0><1| |1><0| |1><1| : -> BasisBraKet .
}

