    -- 1>[1] rule: eq ((KET1 * KET2) ^+) = ((KET1 ^+) * (KET2 ^+))
    --     { KET1 |-> (R * a), KET2 |-> |0> }
    -- 1<[1] (((R * a) * |0>) ^+):Bra --> (((R * a) ^+) * (|0> ^+)):Bra

    -- 1>[2] rule: eq (|0> ^+) = <0|
    --     {}
    -- 1<[2] (|0> ^+):Bra --> (<0|):BasisBra

    -- (((R * a) ^+) * <0|):Bra
    -- (0.0000 sec for parse, 0.0001 sec for 2 rewrites + 8 matches)
    
    -- -------------------------------------
    
    -- CASE 2:
    -- if we use l- or r-assoc on
    -- op _*_ : Ket Ket -> Ket {...-assoc prec: 31} .
    -- reduce in %BRAKET : (((R * a) * |0>) ^+):Bra
    -- ((R * (a ^*)) * <0|):Bra

    -- The trace:
    -- reduce in %BRAKET : (((R * a) * |0>) ^+):Bra
    -- 1>[1] rule: eq ((C * KET) ^+) = ((C ^*) * (KET ^+))
    --     { C |-> (R * a), KET |-> |0> }
    -- 1<[1] (((R * a) * |0>) ^+):Bra --> (((R * a) ^*) * (|0> ^+)):Bra

    -- 1>[2] rule: eq ((C1:Complex * C2:Complex) ^*) = ((C1 ^*) * (C2 ^*))
    --     { C2:Complex |-> R, C1:Complex |-> a }
    -- 1<[2] ((R * a) ^*):Complex --> ((a ^*) * (R ^*)):Complex

    -- 1>[3] rule: eq (R ^*) = R
    --     { R |-> R }
    -- 1<[3] (R ^*):Complex --> R:Real

    -- 1>[4] rule: eq (|0> ^+) = <0|
    --     {}
    -- 1<[4] (|0> ^+):Bra --> (<0|):BasisBra

    -- ((R * (a ^*)) * <0|):Bra
    -- (0.0000 sec for parse, 0.0002 sec for 4 rewrites + 10 matches)
close
eof