mod! REAL {
    [RZero NzReal < Real]

    op _*_ : Real Real -> Real {assoc prec: 31 comm} .
}

mod! COMPLEX {
    pr(REAL)

    [Real Imaginary < Complex]

    op _*_ : Complex Complex -> Complex {assoc prec: 31 comm} .
    -- op _*_ : Complex Real -> Complex {prec: 31} .
    op _^* : Complex -> Complex .
    
    vars C1 C2 : Complex .
    vars R : Real .
    
    eq (C1 * C2)^* = (C1 ^*) * (C2 ^*) .
    eq R ^* = R .
}

mod! BRAKET {
    pr(COMPLEX)
    
    [BasisBra BraZero < Bra]
    [BasisKet KetZero < Ket]

    ops <0| <1| : -> BasisBra .
    ops |1> |0> : -> BasisKet .
    op _[*]_ : Bra Bra -> Bra {assoc prec: 31} . 
    op _[*]_ : Ket Ket -> Ket {assoc prec: 31} . -- Unexpected behavior
    -- op _[*]_ : Ket Ket -> Ket {l-assoc prec: 31} . -- Work well
    -- op _*_ : Ket Ket -> Ket {r-assoc prec: 31} . -- Work well
    op _*_ : Complex Ket -> Ket {prec: 31} .
    op _*_ : Complex Bra -> Bra {prec: 31} .
    op _^+ : Ket -> Bra .

    vars KET KET1 KET2 : Ket .
    vars C : Complex .
    
    eq |0> ^+ = <0| .
    eq |1> ^+ = <1| .

    eq (KET1 [*] KET2)^+ = (KET1 ^+) [*] (KET2 ^+) .
    eq (C * KET)^+     = (C ^*) * (KET ^+) .
}

set trace on
set trace off
open BRAKET .
    var R : Real .
    var a : Complex .
    red (|0> [*] |1>)^+ .
    -- red ((a * R) * (|0> [*] |1>)) .
    red ((a * R) * (|0>))^+ .
    -- red ((a * R) * (|0> [*] |1>))^+ .
    
    -- CASE 1:
    -- if we use assoc on 
    -- op _*_ : Ket Ket -> Ket {assoc prec: 31} .

    -- reduce in %BRAKET : (((R * a) * |0>) ^+):Bra
