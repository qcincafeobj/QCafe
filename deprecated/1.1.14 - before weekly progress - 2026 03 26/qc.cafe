mod! REAL {
    pr(BOOL)
    pr(RAT)
    -- RAT-VALUE: [NzInt < NzRat < Rat], [NzRat Int < Rat ], [Rat < Real], [Zero NzReal < Real]
    [RZero NzReal < Real]

    op -_ : Real -> Real {prec: 15} .

    op _+_ : Real Real -> Real {l-assoc prec: 33 comm} .
    op _-_ : Real Real -> Real {l-assoc prec: 33} .
    op _*_ : Real Real -> Real {l-assoc prec: 31 comm} .
    op _/_ : Real Real -> Real {l-assoc prec: 31} .
        
    op _=_  : Real Real -> Bool {prec: 51 comm} .
    op _>_  : Real Real -> Bool {prec: 51} .
    op _<_  : Real Real -> Bool {prec: 51} .
    op _>=_ : Real Real -> Bool {prec: 51} .
    op _<=_ : Real Real -> Bool {prec: 51} .

    op rzero : -> RZero .
    -- op rone : -> Real .

    op _ pi : Rat -> Real .
    op cos : Real -> Real .
    op sin : Real -> Real {prec: 15} .

    vars R R1 R2 R3 : Real .
    vars RT RT1 RT2 : Rat .
    vars NzR NzR1 NzR2 : NzReal .
    vars NzRT : NzRat .
    
    eq - (RT pi) = (- RT) pi .
    eq - (- R) = R .
    eq - rzero = rzero .

    eq (RT1 pi) + (RT2 pi) = (RT1 + RT2) pi .
    eq R + rzero = R .
    eq R + (- R) = rzero .

    eq R1 - R2 = R1 + (- R2) .
    eq rzero * R = rzero .

    eq (R1 / R2) * R3 = (R1 * R3) / R2 .
    
    -- Built toward cosine and angles in the range [0, pi]
    eq 0 pi = rzero .
    
    eq sin(RT pi) = cos((1/2 - RT) pi) .            -- sin(x) = cos(pi/2 - x)

    eq cos(1/2 pi) = rzero .
    eq R * cos(rzero) = R .
    eq cos(rzero) * R = R .
    eq cos(1 pi) = - cos(rzero) .
    eq R * (- cos(rzero)) = - R .
    eq (- cos(rzero)) * R = - R .
    eq - cos(RT pi) = cos((1 - RT) pi) .            -- cos(pi - x) = - cos(x)

    -- Idea: (a1 + a2 + ... + an) = 0 = (A1 * A2 * ... * An) --> There is a Ai = 0 ~ cos(1/2 pi)
    ceq cos(RT1 pi) + cos(RT2 pi) = rzero if (RT1 + RT2 = 1) .    
    eq  cos(RT1 pi) + cos(RT2 pi) = (cos(rzero) + cos(rzero)) * (
        cos(((RT1 + RT2) / 2) pi) * cos(((RT1 - RT2) / 2) pi)
    ) .

    -- theta > pi <=> theta - 2pi > -pi
    ceq cos(RT pi) = cos((RT - 2) pi) if RT > 1 .   -- cos(x - 2pi) = cos(x)
    ceq cos(RT pi) = cos((- RT) pi)    if RT < 0 .  -- cos(-x) = cos(x)
    
    -- (0 < R1, R2 < pi) and (R1 \neq R2)
    ceq (cos(R1) = cos(R2)) = false if (
        ((rzero < R1) and (R1 < (1 pi)))
        and ((rzero < R2) and (R2 < 1 pi))
        and ((R1 = R2) = false)
    ) .
    eq (- cos(rzero) = cos(rzero)) = false .
    ceq ((R1 * R2) = rzero) = false if false = ((R1 = rzero) or (R2 = rzero)) .
    ceq ((R1 + R2) = rzero) = false if (- R1 = R2) = false .

    eq rzero >  rzero = false .
    eq rzero >= rzero = true .
    eq rzero <  rzero = false .
    eq rzero <= rzero = true .

    eq (cos(rzero) =  rzero) = false .
    eq (cos(rzero) >  rzero) = true .
    eq (cos(rzero) >= rzero) = true .
    eq (cos(rzero) <  rzero) = false .
    eq (cos(rzero) <= rzero) = false .
    
    eq (- cos(rzero) =  rzero) = false .
    eq (- cos(rzero) >  rzero) = false .
    eq (- cos(rzero) >= rzero) = false .
    eq (- cos(rzero) <  rzero) = true .
    eq (- cos(rzero) <= rzero) = true .

    ceq (cos(R) = rzero) = false if (rzero <= R) and (R < 1/2 pi) .    -- 1st quadrant
    ceq (cos(R) = rzero) = false if (1/2 pi < R) and (R <= 1 pi) .     -- 2nd quadrant

    ceq (cos(R) >  rzero) = true if (rzero  <  R) and (R <  1/2 pi) .  -- 1st quadrant
    ceq (cos(R) >= rzero) = true if (rzero  <= R) and (R <= 1/2 pi) .  -- 2nd quadrant
    ceq (cos(R) <  rzero) = true if (1/2 pi <  R) and (R <    1 pi) .  -- 1st quadrant
    ceq (cos(R) <= rzero) = true if (1/2 pi <= R) and (R <=   1 pi) .  -- 2nd quadrant
    
    ceq (cos(R) >  rzero) = false if (1/2 pi <= R) and (R <=   1 pi) . -- 2nd quadrant
    ceq (cos(R) >= rzero) = false if (1/2 pi <  R) and (R <    1 pi) . -- 1st quadrant
    ceq (cos(R) <  rzero) = false if (rzero  <= R) and (R <= 1/2 pi) . -- 2nd quadrant
    ceq (cos(R) <= rzero) = false if (rzero  <  R) and (R <  1/2 pi) . -- 1st quadrant

    eq RT1 pi >  RT2 pi = if (RT1 >  RT2) then true else false fi .
    eq RT1 pi >= RT2 pi = if (RT1 >= RT2) then true else false fi .
    eq RT1 pi <  RT2 pi = if (RT1 <  RT2) then true else false fi .
    eq RT1 pi <= RT2 pi = if (RT1 <= RT2) then true else false fi .
    
    eq RT pi >  rzero = if (RT >  0) then true else false fi .
    eq RT pi >= rzero = if (RT >= 0) then true else false fi .
    eq RT pi <  rzero = if (RT <  0) then true else false fi .
    eq RT pi <= rzero = if (RT <= 0) then true else false fi .
    
    eq rzero >  RT pi = if (0 >  RT) then true else false fi .
    eq rzero >= RT pi = if (0 >= RT) then true else false fi .
    eq rzero <  RT pi = if (0 <  RT) then true else false fi .
    eq rzero <= RT pi = if (0 <= RT) then true else false fi .

    op _*_ : Rat Real -> Real {l-assoc prec: 31 comm} .
    eq (cos(rzero) + cos(rzero)) * R = 2 * R .
    eq (RT1 * R1) * (RT2 * R2) = (RT1 * RT2) * R1 * R2 .

    -- BEGIN: How to commutative
        -- Ensuring the canonical form:
        -- ceq  R1 * R2 = (R2 * R1) if (R2 > R1) .
    -- END: How to commutative
}

mod! COMPLEX {
    pr(REAL)
    
    [Real Imaginary < Complex]

    op -_ : Complex -> Complex {prec: 15} .

    op _+_ : Complex Complex -> Complex {l-assoc prec: 33 comm} .
    op _-_ : Complex Complex -> Complex {l-assoc prec: 33} .
    op _*_ : Complex Complex -> Complex {l-assoc prec: 31 comm} .
    op _/_ : Complex Complex -> Complex {l-assoc prec: 31} .

    op _*_ : Complex Rat -> Complex {l-assoc prec: 31 comm} .
    op _*_ : Rat Complex -> Complex {l-assoc prec: 31 comm} .

    op _+_ : Real Imaginary -> Complex {l-assoc prec: 33} .
    op _+_ : Imaginary Real -> Complex {l-assoc prec: 33} .
    op _+_ : Imaginary Imaginary -> Imaginary {l-assoc prec: 33 comm} .
    
    op _^* : Complex -> Complex .

    op _=_  : Complex Complex -> Bool {prec: 51 comm} .
    op _>_  : Complex Complex -> Bool {prec: 51} .
    op _<_  : Complex Complex -> Bool {prec: 51} .
    op _>=_ : Complex Complex -> Bool {prec: 51} .
    op _<=_ : Complex Complex -> Bool {prec: 51} .

    op i_ : Real -> Imaginary .
    op e^_ : Complex -> Complex .

    op sqrt : Complex -> Complex .
    op |_|^2 : Complex -> Real .

    vars C C1 C2 C3 C4 : Complex .
    vars IMG IMG1 IMG2 : Imaginary .
    vars R R1 R2 : Real .
    vars RT RT1 RT2 : Rat .

    -- norm squared
    eq (C ^*) * C = | C |^2 .

    -- identity element
    eq C * cos(rzero) = C .

    -- constructor
    eq i rzero = rzero .
    
    -- negative elements
    eq - (- C) = C .
    eq C1 * (- C2) = - (C1 * C2) .
    eq - i R   = i (- R) .

    -- addition, substraction
    eq rzero + C   = C .
    eq i R1 + i R2 = i (R1 + R2) .
    eq i R1 - i R2 = i (R1 - R2) .
    
    -- multiplication, division
    eq rzero * C       = rzero .
    eq R1 * (i R2)     = i (R1 * R2) .
    eq (i R1) * (i R2) = - (R1 * R2) .
    
    eq C1 * (C2 / C3) = (C1 * C2) / C3 .
    eq (C1 / C2) * C3 = (C1 * C3) / C2 .
    eq (C1 / C2) / C3 = C1 / (C2 * C3) .
    ceq (R * C) / R = C if (R = rzero) = false .
    eq (C1 * C2) / (C1 * C3) = (C1 / C1) * (C2 / C3) .
    eq (C1 * C2) / C1 = (C1 / C1) * C2 .
    eq C / ((C ^*) * C) = cos(rzero) / C ^* .

    -- conjugate
    eq R ^*     = R .
    eq (i R) ^* = i (- R) .
    eq (R1 + (i R2)) ^* = R1 + (i (- R2)) .
    eq (- C) ^* = - (C ^*) .
    -- eq (R * C) ^* = R * (C ^*) .
    eq (C1 / C2)^* = (C1 ^*) / (C2 ^*) .
    eq (C1 * C2)^* = (C1 ^*) * (C2 ^*) .
    eq (C1 + C2)^* = (C1 ^*) + (C2 ^*) .

    -- Euler formula
    eq e^(i R)  = cos(R) + (i sin(R)) .

    -- coefficient isolation
    -- eq cos(RT1 pi) * (C * cos(RT2 pi)) = (cos(RT1 pi) * cos(RT2 pi)) * C .
    -- eq (C1 * C2) * (C1 * C4) = C2 * (C4 * (C1 * C1)) .

    -- eq C * C1 + C * C2 = C * (C1 + C2) .
    -- eq C1 * (C2 * C1) = (C1 * C1) * C2 .
    eq (C1 * C) * (C2 * C) = (C * C) * (C1 * C2) .
    eq C * C1 + C * C2 = C * (C1 + C2) .
    -- eq C + C =  C * (2 * cos(rzero)) .
    -- eq C1 * (RT * C2) = RT * (C1 * C2) .
    eq C + C = 2 * C .
    eq RT * C1 + RT * C2 = RT * (C1 + C2) .
    
    -- eq C1 * (RT * C2) = RT * (C1 * C2) .
    eq C * (RT * (C ^*)) = RT * | C |^2 .
    eq (C ^*) * (RT * C) = RT * | C |^2 .
    eq C1 * ((C1 ^*) * C2) = C2 * (| C1 |^2) .

    -- eq C1 * | C2 |^2 = | C2 |^2 * C1 .

    -- square root
    -- eq sqrt(C * C) = C .
    eq sqrt(C) * sqrt(C) = C .
    eq sqrt(C1 * C2) = sqrt(C1) * sqrt(C2) .
    eq sqrt(C1 / C2) = sqrt(C1) / sqrt(C2) .
    eq sqrt(C1 * C2 + C1 * C3) = sqrt(C1) * sqrt(C2 + C3) .
    eq sqrt(cos(rzero)) = cos(rzero) .
    eq sqrt(C1) * (sqrt(C1) * C2) = C1 * C2 .
    eq sqrt(2 * cos(rzero)) = cos(rzero) / cos(1/4 pi) .
}

mod! BRAKET {
    pr(NAT)
    pr(COMPLEX)

    [BasisBra BraZero < Bra]
    [BasisKet KetZero < Ket]
    -- [Bra Ket < Vect]

    [BasisKetBra < Mat]
    
    ops <0| <1| : -> BasisBra .
    ops |1> |0> : -> BasisKet .
    ops |0><0| |0><1| |1><0| |1><1| : -> BasisKetBra .
    op bO : -> BraZero . -- [ 0 0 ] = O
    op kO : -> KetZero . -- [ 0 0 ]^T = kO

    op ||_||^2 : Ket -> Real .
    op _=_ : Bra Bra -> Bool {prec: 51 comm} .

    op _^+ : Ket -> Bra {prec: 15} .                    -- dagger/conjugate transpose
    op -_  : Ket -> Ket {prec: 15} .
    op -_  : BasisKet -> BasisKet {prec: 15} .
    op _+_ : Ket Ket -> Ket {prec: 33 comm} .
    op _+_ : Bra Bra -> Bra {prec: 33 comm} .
    -- _`(*`)_
    -- _*_ : tenprod, Complex * Mat
    op _*_ : Ket Ket -> Ket {r-assoc prec: 31} .        -- tenprod |_> (x) |_>
    op _*_ : Bra Bra -> Bra {r-assoc prec: 31} .        -- tenprod <_| (x) <_|
    op _*_ : Complex Bra -> Bra {prec: 31} .
    op _*_ : Complex Ket -> Ket {prec: 31} .
    
    -- _x_ : innprod, outprod, matmul
    op _x_ : Bra Ket -> Complex {prec: 31} .             -- innprod   <_|_>
    op _x_ : Ket Bra -> Mat {prec: 31} .                 -- outerprod |_><_|
    
    op -_  : Mat -> Mat {prec: 15} .
    op _+_ : Mat Mat -> Mat {r-assoc prec: 33 comm} .
    op _-_ : Mat Mat -> Mat {l-assoc prec: 33} .
    op _x_ : Mat Mat -> Mat {r-assoc prec: 31} .        -- matmul
    op _*_ : Mat Mat -> Mat {r-assoc prec: 31} .        -- tenprod, to be checked
    
    op _*_ : Complex Mat -> Mat {r-assoc prec: 31} .
    op _x_ : Mat Ket -> Ket {r-assoc prec: 31} .        -- matmul with Ket

    vars BB BB1 BB2 : BasisBra .
    vars BK BK1 BK2 : BasisKet .
    vars BRA BRA1 BRA2 BRA3 : Bra .
    vars KET KET1 KET2 KET3 KET4 : Ket .
    vars M M1 M2 M3 : Mat .
    vars C C1 C2 : Complex .
    vars N N1 N2 : Nat .
    -- vars V V1 V2 V3 : Vect .

    -- norm squared
    eq || KET ||^2 = (KET ^+) x KET .
    -- eq || C * KET ||^2 = | C |^2 * || KET ||^2 .

    -- bra equalities
    eq (<0| = <0|) = true .
    eq (<0| = <1|) = false .
    eq (<1| = <0|) = false .
    eq (<1| = <1|) = true .

    -- dagger/conjugate transpose
    eq |0> ^+ = <0| .
    eq |1> ^+ = <1| .
    eq (KET1 + KET2)^+ = (KET1 ^+) + (KET2 ^+) .
    -- eq (KET1 * KET2)^+ = (KET2 ^+) * (KET1 ^+) .
    eq (KET1 * KET2)^+ = (KET1 ^+) * (KET2 ^+) .
    eq (C * KET)^+  = (C ^*) * (KET ^+) .

    -- outprod in orthogonal bases
    eq BB x BK = if (BK ^+ = BB) then cos(rzero) else rzero fi .
    eq |0><0| = |0> x <0| .
    eq |0><1| = |0> x <1| .
    eq |1><0| = |1> x <0| .
    eq |1><1| = |1> x <1| .

    -- handling kO = [0 0]^T
    eq rzero * KET = kO .
    eq - kO        = kO .
    eq kO * KET    = kO .
    eq KET * kO    = kO .
    eq C * kO      = kO .
    eq kO + kO     = kO .
    eq kO + KET    = KET .
    eq M x kO      = kO .

    -- substraction
    eq M1 - M2 = M1 + (- M2) .
    -- eq M + (- M) = rzero * M .

    -- matmul
    eq (BK x BB) x BK1     = (BB x BK1) * BK .
    eq (M1 x M2) x KET     = M1 x (M2 x KET) .

    -- distribition of operators into addition
    eq (M1 + M2) x KET     = M1 x KET + M2 x KET .
    eq (M1 + M2) * M3      = M1 * M3 + M2 * M3 .
    eq (KET1 + KET2) * KET = KET1 * KET + KET2 * KET .
    eq M x (KET1 + KET2)   = M x KET1 + M x KET2 .

    eq (KET1 + KET2) x BRA = KET1 x BRA + KET2 x BRA .
    eq KET x (BRA1 + BRA2) = KET x BRA1 + KET x BRA2 .
    
    eq C * (KET1 + KET2) = C * KET1 + C * KET2 .

    eq (BRA1 + BRA2) x KET = BRA1 x KET + BRA2 x KET .
    eq BRA x (KET1 + KET2)   = BRA x KET1 + BRA x KET2 .
    eq KET * (KET1 + KET2) = KET * KET1 + KET * KET2 .

    -- complex coefficient isolation
    eq cos(rzero) * KET    = KET .
    eq KET1 * (C * KET2)   = C * (KET1 * KET2) .
    eq (C * M1) * M2       = C * (M1 * M2) .
    eq (C * M) x KET       = C * (M x KET) .
    eq (C * KET1) * KET2   = C * (KET1 * KET2) .
    eq M x (C * KET)       = C * (M x KET) .
    eq C * (- KET)         = (- C) * KET .
    eq C1 * (C2 * KET)     = (C1 * C2) * KET .

    eq KET x (C * BRA) = C * (KET x BRA) .
    eq (C * KET) x BRA = C * (KET x BRA) .
    
    eq BRA x (C * KET) = C * (BRA x KET) .
    eq (C * BRA) x KET = C * (BRA x KET) .

    eq (C1 * KET + KET1) + (C2 * KET + KET2) = (C1 + C2) * KET + (KET1 + KET2) .
    eq C1 * KET + C2 * KET = (C1 + C2) * KET .

    -- innprod
    eq (BB * BRA) x (BK * KET) = (BB x BK) * (BRA x KET) .

    -- assoc
    eq (BRA1 * BRA2) * BRA3 = BRA1 * (BRA2 * BRA3) .

    -- negative elements
    -- eq (- M1) * M2         = - (M1 * M2) .
    eq (- M) x KET         = - (M x KET) .
    eq M x (- KET)         = - (M x KET) .
    eq KET1 * (- KET2)     = - (KET1 * KET2) .
    eq ((- M1) * M2) x KET = - ((M1 * M2) x KET) .
}

mod! NATLIST {
    pr(NAT)
    -- a lite version for NatList (with no empty list)

    [NatList]
    op _ _ : Nat Nat -> NatList .
    op _ _ : Nat NatList -> NatList .
}

mod! GATE {
    pr(NATLIST)
    pr(BRAKET)
    
    [Gate ControlledGate < Mat]
    [Controller GateName]
    [Measurement]

    -- gates supported
    ops X Y Z H P0 P1 : -> GateName .       -- GN(K): operator matrix for qubit K
    ops S SI T TI : -> GateName .
    -- ops Rx Ry Rz R1 : -> GateName .      -- rotation gates with theta angle
    op _ _ : GateName Nat -> Gate {prec: 15} .
    -- try op _`_ : GateName Nat -> Gate {prec: 15} .
    
    -- controlled and multi-controlled mechanisms
    op C _ _ _ : Nat GateName Nat -> ControlledGate {prec: 15} .
    -- try op C`_`(_`,_`) : GateName Nat Nat -> ControlledGate {prec: 15} .
    op MC [_] _ _ : NatList GateName Nat -> ControlledGate {prec: 13} .

    op I : Nat -> Gate .    -- I(N): identity gate for N qubits
    op I : -> Gate .        -- Dimension helper: General identity gate, contextual size (from 0 to N)

    op basemat : GateName -> Mat .

    op _*_ : Gate Gate -> Gate {r-assoc prec: 31} . -- tenprod
    op _x_ : Gate Ket -> Ket {r-assoc prec: 31} .   -- matmul
    op _x_ : Measurement Ket -> Ket {r-assoc prec: 31 strat: (2 1 0)} .
    
    op msment-op : Mat -> Measurement .

    vars GN : GateName .
    vars N K K1 K2 K3 : Nat .
    vars KET : Ket .
    vars BK BK1 : BasisKet .
    vars BB : BasisBra .
    vars M : Mat .
    vars NL : NatList .
    vars KET1 KET2 : Ket .

    eq basemat(X)  = (|0><1| + |1><0|) .
    eq basemat(Y)  = (i cos(rzero)) * (- |0><1| + |1><0|) .
    eq basemat(Z)  = |0><0| - |1><1| .
    eq basemat(H)  = cos(1/4 pi) * ((|0><0| + |0><1|) + (|1><0| - |1><1|)) .
    eq basemat(P0) = |0><0| .
    eq basemat(P1) = |1><1| .

    eq basemat(S)  = |0><0| + (i cos(rzero)) * |1><1| .
    eq basemat(SI) = |0><0| - (i cos(rzero)) * |1><1| .     -- Inverse S gate
    eq basemat(T)  = |0><0| + (e^(i (1/4 pi))) * |1><1| .
    eq basemat(TI) = |0><0| + (e^(- i (1/4 pi))) * |1><1| . -- Inverse T gate

    -- K: qubit index (0, 1, 2, ...)
    -- gate mechanisms
    eq GN(K)           = (I(K) * basemat(GN) * I) .
    eq C(K1)GN(K2)     = P0(K1) +       GN(K2) x P1(K1) .
    eq MC[K1 K2]GN(K3) = P0(K1) +  C(K2)GN(K3) x P1(K1) .
    eq MC[K1 NL]GN(K2) = P0(K1) + MC[NL]GN(K2) x P1(K1) .

    -- handling I(N) while ensuring the dimensions
    eq (I(N) * M) x (BK * KET) = BK * ((I(sd(N, 1)) * M) x KET) .
    eq (I(1) * M) x (BK * KET) = BK * (M x KET) .
    eq I(0) * M =  M .

    -- handling dimension helper I
    eq ((BK x BB) * M) x (BK1 * KET) = ((BK x BB) x BK1) * (M x KET) .
    eq ((BK x BB) * I) x BK1 = (BK x BB) x BK1 .
    eq I x KET = KET .

    -- normalization
    eq msment-op(M) x KET = (cos(rzero) / sqrt(|| M x KET ||^2)) * (M x KET) .
    -- eq msment-op(M) x KET = (M x KET) .
    -- eq msment-op(M) x KET = (
    --     cos(rzero) / sqrt(|| M x KET ||^2)
    -- ) * (M x KET) .
    -- will give normalize(M x KET1) + normalize(M x KET2) instead of normalize(M x (KET1 + KET2))
    -- i.e. if msment-op is a matrix, M x (KET1 + KET2) will cause unexpected behaviors
}