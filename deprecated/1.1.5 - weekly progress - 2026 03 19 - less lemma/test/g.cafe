    red apply(Z[tidx(0)], ket("01")) .
    red apply(Z[tidx(5)], ket("01")) .
    red apply(Z[tidx(2)], ket("011101")) .
    red apply(Z[tidx(5)], ket("011101")) .
    --> ----------------------------------------------------
