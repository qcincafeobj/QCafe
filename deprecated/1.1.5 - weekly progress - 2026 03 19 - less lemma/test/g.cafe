-- input ../qc-old.cafe .
-- input ../qc-main.cafe .
input ../qc.cafe .

-- -- open SQRT .
-- -- open GATE .

-- red (- i cos(rzero)) * |1><1| + |0><0| . -- give Mat
-- red |0><0| - (i cos(rzero)) * |1><1| .   -- give Mat
-- red |0><0| + (- i cos(rzero)) * |1><1| . -- give ?Mat

-- open GATE .

-- close
-- eof

open GATE .
    -- --> TEST 1
    -- red - |1> .
    -- red |0> + |1> .
    -- red |0> * |1> .
    -- red |1> * (|0> + (- |1>)) .
    -- -->
    -- --> TEST 2
    -- red (X 0) x |0> .
    -- red (X 1) x |0> * |1> .
    -- red (X 1) x |0> * |1> .
    -- red X(1) x |0> * |1> .
    -- red X 0 .
    -- red X 5 .
    -- red C 5 X 7 .
    -- red MC [1 2 3] H 7 .
    -->
    --> TEST 3
    red C 0 X 1 x |0> * |0> .
    red C 0 X 1 x |0> * |1> .
    red C 0 X 1 x |1> * |0> .
    red C 0 X 1 x |1> * |1> .
    -->
    --> TEST 4
    red C 0 H 1 x |1> * |1> .
    red C 0 Z 1 x |1> * |1> .
    red C 0 Y 1 x |1> * |1> .
    -->
    --> TEST 5
    red MC [0 2 3] Y 1 x |0> * |1> * |1> * |1> .
    red MC [0 2 3] Y 1 x |1> * |1> * |1> * |1> .
    red MC [0 2 3] Y 1 x |1> * |0> * |1> * |0> .
    red MC [0 2 3] Y 1 x |1> * |0> * |1> * |1> .
    -->
    --> TEST 6
    red MC [0 2 3] SI 1 x |0> * |1> * |1> * |1> .
    red MC [0 2 3] SI 1 x |1> * |1> * |1> * |1> .
    red MC [0 2 3] SI 1 x |1> * |0> * |1> * |0> .
    red MC [0 2 3] SI 1 x |1> * |0> * |1> * |1> .
    -->
    -- --> TEST 7
    -- red basemat(X) .
    -- red basemat(S) .
    -- red basemat(SI) .
    -- red basemat(T) .
    -- red basemat(TI) .
close

eof

(
    |1> * (
        - ((i cos(rzero)) * (|1> * (|1> * |1>)))
    )
):Ket

(
    (((|0> x <0|) * I) x (|1> * (|0> * (|1> * |1>)))) + (
        (
            (I(2) * ((|0> x <0|) * I)) x (((|1> x <1|) * I) x (|1> * (|0> * (|1> * |1>))))
        ) + (
            (
                (I(3) * ((|0> x <0|) * I)) x (
                    (I(2) * ((|1> x <1|) * I)) x (
                        ((|1> x <1|) * I) x (|1> * (|0> * (|1> * |1>)))
                    )
                )
            ) + (
                (
                    I(1) * (
                    ((|0> x <0|) + (- ((i cos(rzero)) * (|1> x <1|)))) * I
                    )
                ) x (
                    (I(3) * ((|1> x <1|) * I)) x (
                        (I(2) * ((|1> x <1|) * I)) x (
                            ((|1> x <1|) * I) x (|1> * (|0> * (|1> * |1>)))
                        )
                    )
                )
            )
        )
    )
):Ket
-- Circuit -> Compiler -> Optimized Circuit (Actual Circuit)
(
    (I(2) * ((|1> x <1|) * I)) x (
        ((|1> x <1|) * I) x (|1> * (|0> * (|1> * |1>)))
    )
)

((bkzero * (|0> * (|1> * |1>))) + ((bkzero * (|1> * (|0> * |1>))) + ((bkzero * (|1> * (|0> * |1>))) + (
    |1> * (
        (((|0> x <0|) + (- ((i cos(rzero)) * (|1> x <1|)))) * I) x (|0> * (|1> * |1>))
    )
)))):Ket

((bkzero * (|0> * (|1> * |1>))) + ((bkzero * (|1> * (|0> * |1>))) + ((|1> * (|0> * (|1> * (((|0> x <0|) * I) x |1>)))) + (|1> * ((((|0> x <0|) + (- ((i cos(rzero)) * (|1> x <1|)))) * I) x (
    |0> * (
        |1> * (
            ((|1> x <1|) * I) x |1>
        )
    )
)))))):Ket

open DISPLAY .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 1: misc/debug
    red p (0:Nat) .     -- (p 0:Nat):?FindResult+Float
    red p (5 + 10) .    -- 14
    red 1 = 1 .         -- true
    red 1 = 2 .         -- (1 = 2):Bool
    red 1 == 2 .        -- false
    red 1 > 0 .         -- true
    red 0 = 0 .
    -->
    red sd(1, 2) > 0 .
    red sd(2, 1) > 0 .
    red length("123") .
    red p (sd(nqubits(ket("0101")), 2)) .
    -->
    red nqubits(ket("")) .
    red ncols(I(8)) .
    red nrows(ket("01")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 2: tenprod
    red tenprod(ket("11"), ket("101")) .
    red tenprod(bra("11"), ket("101")) .
    red tenprod(ket("100001"), ket("123")) .
    --> ----------------------------------------------------
    --> ----------------------------------------------------
    --> TEST 3: matmul
    red matmul(I(4), ket("01")) .
    red matmul(I(8), ket("01")) .
    
    red matmul(bra("01"), I(4)) .
    red matmul(bra("01"), I(8)) .
    --> ----------------------------------------------------
