input ../qc.cafe .

set trace on
set trace off

open COMPLEX .
    --> TEST 1
    red i rzero .
    red i cos(5/8 pi) .
    red - i cos(5/8 pi) .
    red - i cos(rzero) .
    red rzero * cos(2/5 pi) .
    red cos(2/5 pi) * rzero .
    
    --> TEST 2
    red i cos(3/5 pi) - i cos(3/5 pi) .
    red (i cos(3/5 pi) - i cos(2/5 pi)) * (i cos(3/5 pi) - i cos(2/5 pi)) .
    red (i cos(3/5 pi) - i cos(4/5 pi)) * (i cos(3/5 pi) - i sin(2/5 pi)) .
    red (i cos(3/5 pi) - i cos(3/4 pi)) * (- i cos(3/5 pi) + i cos(3/4 pi)) .
    red (i cos(2/5 pi) - i cos(4/5 pi)) * (i cos(1/7 pi) - i cos(2/3 pi)) .
close
set trace off
eof

(
    - (
        (
            (
                (
                    cos((5/21 pi)) * cos((2/21 pi))
                ) * (
                    cos((3/10 pi)) * cos((1/10 pi))
                )
            ) + (
                (
                    cos((5/21 pi)) * cos((2/21 pi))
                ) * (
                    cos((3/10 pi)) * cos((1/10 pi))
                )
            )
        ) + (
            (
                (
                    cos((5/21 pi)) * cos((2/21 pi))
                ) * (
                    cos((3/10 pi)) * cos((1/10 pi))
                    )
            ) + (
                (
                    cos((5/21 pi)) * cos((2/21 pi))
                ) * (
                    cos((3/10 pi)) * cos((1/10 pi))
                )
            )
        )
    )
):Real

(
    - (
        (
            (cos((1/7 pi)) * cos((2/5 pi))) + (cos((1/3 pi)) * cos((2/5 pi)))
        ) + (
            (cos((1/7 pi)) * cos((1/5 pi))) + (cos((1/3 pi)) * cos((1/5 pi)))
        )
    )
):Real

(
    - (
        (
            (cos(rzero) + cos(rzero)) * (cos((17/40 pi)) * cos((7/40 pi)))
        ) * (
            (cos(rzero) + cos(rzero)) * (cos((23/40 pi)) * cos((7/40 pi)))
        )
    )
):Real