close

eof

tenprod(X(t-idx(3)), X(t-idx(5))) = (
    tenprod(
        tenprod(
            tenprod(
                I(8),
                (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
            ),
            I(32)
        ),
        (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
    )
):Mat

(Im(-1) * outprod("0","1")) + outprod("0","1") = (
    (
        Im(-1) * matmul(ket("0"),bra("1"))
    ) + matmul(ket("0"),bra("1"))
):Mat

apply(Y(t-idx(5)),ket("011101")) = (
    matmul(
        tenprod(
            I(32),
            ((Im(-1) * matmul(ket("0"),bra("1"))) + (Im(1) * matmul(ket("1"),bra("0"))))
        ),
        ket("011101")
    )
):Mat