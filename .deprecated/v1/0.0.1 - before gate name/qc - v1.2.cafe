mod! GATE {
    -- pr(NAT)
    pr(PRODUCT)
    -- pr(RAT)
    -- pr(SQRT)

    [Gate < Mat]
    [Stage TargetIndex ControlIndex]

    op t-idx : Nat -> TargetIndex .  -- 0, 1, 2, 3, ...
    op c-idx : Nat -> ControlIndex . -- 0, 1, 2, 3, ...
    
    -- Nat -> TargetIndex -> Gate
    -- Gate -> Nat
    -- "Transitive" is just an informal term that I use to describe it
    -- I'm not sure about the name
    op T-IDX : Gate -> Nat {strat: (0 1) prec: 0} .  -- Transitive-inverse (???) function
    op C-IDX : Gate -> Nat {strat: (0 1) prec: 0} . -- Transitive-inverse (???) function

    -- op MSMNT : IQubit -> State . -- Measurement

    -- I(N) (in MATRIX, which maps Nat -> Gate) is different from I(t-idx(N))

    ops X Y Z H I : TargetIndex -> Gate .
    ops CX CZ : ControlIndex TargetIndex -> Gate .
    ops P0 P1 : ControlIndex TargetIndex -> Gate . -- Projection operators
    
    -- -- 0: operator; 1, 2: 1st, 2nd param
    -- -- Allow [apply.1] to execute first
    op apply : Gate KetVec -> KetVec {strat: (0) prec: 1} . -- The dimensions should be (n x m) x (m x 1) = n x 1
    -- op apply : Gate KetVec -> Mat {strat: (0)} .

    vars K K1 K2 : Nat . -- i = 0, 1, 2, ...
    vars N N1 N2 : Nat .
    var KVEC : KetVec .
    vars M M1 M2 : Mat .
    var PSI : String .
    var G : Gate .
    
    -- START: [X]
        -- I don't want
        -- [Warning]: axiom : eq X(t-idx(K)) = tenprod(I(2),X(t-idx(p K)))
        -- contains error operators. (due to p _)
        -- eq X(t-idx(0)) = outprod("0", "1") + outprod("1", "0") .
        -- eq X(t-idx(K)) = tenprod(I(2), X(t-idx(p K))) .
        -- ceq X(t-idx(K)) = outprod("0", "1") + outprod("1", "0") if (K = 0) .
        -- ceq X(t-idx(K)) = tenprod(I(fastpow(2, K)), X(t-idx(0))) if not (K = 0) .
        ceq X(t-idx(K)) = outprod("0", "1") + outprod("1", "0")     if (K = 0) .
        ceq X(t-idx(K)) = tenprod(I(fastpow(2, K)), X(t-idx(0)))    if (K > 0) .
        -- ceq X(t-idx(K)) = tenprod(I(fastpow(2, K)), X(t-idx(0))) if not (K = 0) . -- False
        -- Alternative: 
        -- ceq X(t-idx(K)) = tenprod(I(2), X(t-idx(sd(K, 1)))) if (K > 0) . -- Recursive

        eq ncols(X(t-idx(K))) = fastpow(2, K + 1) .
        eq T-IDX(X(t-idx(K))) = K .
    -- END: [X]
    
    -- START: [Y]
        ceq Y(t-idx(K)) = Im(-1) * outprod("0", "1") + Im(1) * outprod("1", "0")    if (K = 0) .
        ceq Y(t-idx(K)) = tenprod(I(fastpow(2, K)), Y(t-idx(0)))                    if (K > 0) .
        -- ceq Y(t-idx(K)) = tenprod(I(fastpow(2, K)), Y(t-idx(0))) if not (K = 0) . -- False
        -- Alternative: ceq Y(t-idx(K)) = tenprod(I(2), Y(t-idx(sd(K, 1)))) if (K > 0) . -- Recursive

        eq ncols(Y(t-idx(K))) = fastpow(2, K + 1) .
        eq T-IDX(Y(t-idx(K))) = K .
    -- END: [Y]
    
    -- START: [Z]
        ceq Z(t-idx(K)) = outprod("0", "0") - outprod("1", "1")     if (K = 0) .
        ceq Z(t-idx(K)) = tenprod(I(fastpow(2, K)), Z(t-idx(0)))    if (K > 0) .
        -- ceq Z(t-idx(K)) = tenprod(I(fastpow(2, K)), Z(t-idx(0))) if not (K = 0) . -- False
        -- Alternative: ceq Z(t-idx(K)) = tenprod(I(2), Z(t-idx(sd(K, 1)))) if (K > 0) . -- Recursive

        eq ncols(Z(t-idx(K))) = fastpow(2, K + 1) .
        eq T-IDX(Z(t-idx(K))) = K .
    -- END: [Z]
    
    -- START: [H]
        ceq H(t-idx(K)) = (Re(1) / sqrt(Re(2))) * (
            outprod("0", "0")
            + outprod("0", "1")
            + outprod("1", "0")
            - outprod("1", "1")
        ) if (K = 0) .
        -- ceq H(t-idx(K)) = (Re(1) / sqrt(Re(2))) * (
        --     Z(t-idx(0)) + X(t-idx(0))
        -- ) if (K = 0) .
        ceq H(t-idx(K)) = tenprod(I(fastpow(2, K)), H(t-idx(0))) if (K > 0) .
        -- ceq H(t-idx(K)) = tenprod(I(fastpow(2, K)), H(t-idx(0))) if not (K = 0) . -- False
        -- Alternative: ceq H(t-idx(K)) = tenprod(I(2), H(t-idx(sd(K, 1)))) if (K > 0) . -- Recursive

        eq ncols(H(t-idx(K))) = fastpow(2, K + 1) .
        eq T-IDX(H(t-idx(K))) = K .
    -- END: [H]
    
    -- -- START: [CX]
    --     -- ceq CX(c-idx(K), t-idx(K + 1)) = (
    --     --     tenprod(I(2), X(t-idx(0)))
    --     --     - tenprod(
    --     --         outprod("0", "0"),
    --     --         X(t-idx(0)) - I(2)
    --     --     )
    --     -- ) if (K = 0) .

    --     -- ceq CX(c-idx(K), t-idx(K + 1)) = tenprod(
    --     --     I(fastpow(2, K)), 
    --     --     CX(c-idx(0), t-idx(1))
    --     -- ) if (K > 0) .

    --     eq CX(c-idx(0), t-idx(1)) = I(2) .
        
    --     ceq CX(c-idx(K), t-idx(1 + K)) = tenprod(
    --         I(fastpow(2, K)), 
    --         CX(c-idx(0), t-idx(1))
    --     ) if not (K = 0) .

    --     -- -- ceq ncols(CX(c-idx(K1), t-idx(K2))) = fastpow(2, K1 + 1) if (K1 > K2) .
    --     -- -- ceq ncols(CX(c-idx(K1), t-idx(K2))) = fastpow(2, K2 + 1) if (K2 > K1) .
    --     ceq ncols(CX(c-idx(K1), t-idx(K2))) = fastpow(2, K2 + 1) if (K2 > K1) .
    -- -- END: [CX]
    
    -- START: [apply]    
        -- APPROACH 1:
        -- p gives 
        -- [Warning]: axiom : ceq apply(X(t-idx(K)),KVEC) = matmul(tenprod(X(t-idx(K)),I((p sd(nqubits(KVEC),K)))),KVEC)
        --    if (K < nqubits(KVEC))
        -- contains error operators.
        -- 
        -- ceq apply(X(t-idx(K)), KVEC) = matmul(
        --     tenprod(
        --         X(t-idx(K)),
        --         I(p (sd(nqubits(KVEC), K)))
        --     ),
        --     KVEC
        -- ) if (K < nqubits(KVEC)) .
        -- Alternative: ceq [apply-1] : apply(X(t-idx(K)), ket(PSI)) = errMat if not (K < length(PSI)) .
        -- ceq [apply.X1]  : apply(X(t-idx(K)), KVEC) = errMat if not (K < nqubits(KVEC)) .
        -- APPROACH 2:
        ceq [apply.1] : apply(G, KVEC) = errMat if ncols(G) > nrows(KVEC) .
        
        
        -- -- n-qubit --> 2^n = (2^k) * 2 + r --> r = 2^n - (2^k * 2) = 2^n - ncols
        -- eq [apply.2] : apply(G, KVEC) = tenprod(
        --     G, 
        --     I(sd(
        --         fastpow(2, nqubits(KVEC)),
        --         ncols(G)
        --     ))
        -- ) .  -- G will be rewritten too specifically before "ncols" is applied
        -- -- ) if ncols(G) <= nrows(KVEC) .
        
        -- n-qubit --> n - 1 = K + R --> R = n - K - 1
        eq [apply.2] : apply(G, KVEC) = tenprod(
            G, 
            I(fastpow(
                2, 
                sd(
                    sd(nqubits(KVEC), T-IDX(G)), 
                    1
                )
            ))
        ) .
