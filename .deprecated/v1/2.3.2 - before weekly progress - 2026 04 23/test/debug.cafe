mod! PNAT {
    pr(BOOL)
    
    [PZero NzPNat < PNat]
    op 0 : -> PZero .
    op s : PNat -> NzPNat .
}

mod! FOO {
    pr(PNAT)
    pr(NAT)
    
    [Foo FooSet]

    op f : Nat Nat -> Foo .
    op _+_ : Foo Foo -> Foo {assoc comm} .
    op {_} : Foo -> FooSet .
    op bar : PNat FooSet -> FooSet {strat: (2 1 0)} .
    op g : FooSet -> Foo .

    vars N1 N2 N3 N4 : Nat .
    vars PN : PNat .
    vars FS : FooSet .
    vars F : Foo .

    eq f(N1, N2) + f(N3, N4) = f(N1 + N3, N2 + N4) .
    eq bar(0, {F}) = {F + g({F})} .
    eq bar(s(PN), {F}) = bar(PN, {F}) .
    
}

--> won't work
open FOO .
    ops n1 n2 : -> Nat .
    op value : -> Foo .
    op pn : -> PNat .
    eq value = f(n1 + n2, n2) .
    eq bar(pn, {value}) = {f(1000, 1000)} .
    red bar(s(pn), {value}) . -- produce (bar(pn,({ f((n1 + n2),n2) }))):FooSet
close

--> work 1
open FOO .
    ops n1 n2 : -> Nat .
    var VALUE : Foo .
    op pn : -> PNat .
    eq VALUE = f(n1 + n2, n2) .
    eq bar(pn, {VALUE}) = {f(1000, 1000)} .
    red bar(s(pn), {VALUE}) . -- produce ({ f(1000,1000) }):FooSet
    red VALUE . --> produce VALUE:Foo
close

--> work 2
open FOO .
    ops n1 n2 : -> Nat .
    op value : -> Foo .
    op pn : -> PNat .
    eq value = f(n1 + n2, n2) .
    eq bar(pn, {f(n1 + n2, n2)}) = {f(1000, 1000)} .
    red bar(s(pn), {value}) . -- produce ({ f(1000,1000) }):FooSet
close