input ../qc.cafe .
-- input ../qc1.0.11.cafe .

-- open GATE .

-- close

-- eof

open GATE .
    ops a b : -> Complex .
    -->
    --> Teleport (with measurement abstraction):
    red (C(0)Z(2))
        x (C(1)X(2))
        x (cos(1/4 pi) * (P0(1) + P1(1)))
        x (cos(1/4 pi) * (P0(0) + P1(0)))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    -->
    --> Teleport
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P0(0))
        x (P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    -->
    --> Teleport (with coefficient trick to run faster):
    red (cos(1/4 pi) * cos(1/4 pi)) * (
        C(0)Z(2)
        x C(1)X(2)
        x (P0(1) + P1(1))
        x (P0(0) + P1(0))
        x H(0) 
        x C(0)X(1)
        x C(1)X(2)
        x H(1)
        x (a * |0> + b * |1>) * |0> * |0>
     ) .
close

eof

-- Teleport (with measurement abstraction):
-- cos((1/4 pi))^4 = 0.25
-- 0.25 * (4 cases) = 1
(
    cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
        (
            (
                (a * (|0> * (|0> * |0>))) + (b * (|0> * (|0> * |1>)))
            ) + (
                (a * (|0> * (|1> * |0>))) + (b * (|0> * (|1> * |1>)))
            )
        ) + (
            (
                (a * (|1> * (|0> * |0>))) + (b * (|1> * (|0> * |1>)))
            ) + (
                (a * (|1> * (|1> * |0>))) + (b * (|1> * (|1> * |1>)))
            )
        )
    )
)))):Ket -- op getNthQubit : Ket -> Ket . ???

-- (Normal) Teleport
(
    cos((1/4 pi)) * (cos((1/4 pi)) * (
        (
            a * (|0> * (|1> * |0>))
        ) + (
            b * (|0> * (|1> * |1>))
        )
    )
)):Ket