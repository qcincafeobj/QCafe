mod! DISPLAY {
    pr(INT2STRING)
    -- pr(FLOAT2STRING)
    pr(GATE)

    op display : Mat -> String {strat: (1 0)} .
    op display : Complex -> String {strat: (1 0)} .
    -- op _++_ : Mat String -> String .
    -- op _++_ : String Mat -> String .
    -- op tostring : Mat -> String {prec: 0} .

    vars K K1 K2 : Nat . -- i = 0, 1, 2, ...
    vars N N1 N2 : Nat .
    var KVEC : KetVec .
    vars M M1 M2 : Mat .
    vars PSI PSI1 PSI2 : String .
    vars G G1 G2 : Gate .
    vars GN GN1 GN2 : GateName .
    vars F F1 F2 : Float .
    vars C C1 C2 : Complex .
    
    eq display(M1 + M2)         = ((("(" ++ display(M1)) ++ " + ") ++ display(M2)) ++ ")" .
    -- eq display(M1 - M2)         = ((("(" ++ display(M1)) ++ " - ") ++ display(M2)) ++ ")" . -- won't work
    eq display(- M)            = ("(- (" ++ display(M)) ++ "))" .
    -- eq display(matmul(M1, M2))  = "(" ++ display(M1) ++ " x "   ++ display(M2) ++ ")" .
    -- eq display(tenprod(M1, M2)) = "(" ++ display(M1) ++ " (x) " ++ display(M2) ++ ")" .
    -- eq display(tenprod(M1, M2)) = "[" ++ display(M1) ++ " (x) " ++ display(M2) ++ "]" .
    -- eq display(matmul(M1, M2))  = display(M1) ++ " x "   ++ display(M2) .
    eq display(tenprod(M1, M2)) = (display(M1) ++ " (x) ") ++ display(M2) .
    
    eq display(I(N)) = ("I(" ++ int2str(N)) ++ ")" .
    
    eq display(matmul(ket(PSI1), bra(PSI2))) = display(ket(PSI1)) ++ display(bra(PSI2)) .
    eq display(matmul(M, ket(PSI))) = ((("(" ++ display(M)) ++ ")") ++ " x ") ++ display(ket(PSI)) .
    eq display(matmul(M1, M2)) = ((("(" ++ display(M1)) ++ ")") ++ " x ") ++ (("(" ++ display(M2)) ++ ")") .
    
    eq display(ket(PSI)) = ("|" ++ PSI) ++ ">" .
    eq display(bra(PSI)) = ("<" ++ PSI) ++ "|" .
    
    eq display(Im(F)) = "i" ++ "SOME-F" .
    eq display(Re(F)) = "SOME-F" .

    -- eq display(Im(F)) = "i" ++ float2str(F, 10) .
    -- eq display(Re(F)) = float2str(F, 10) .
    -- eq display(Re(F)) = int2str(Int(F), 10) .

    eq display(C * M) = ((("(" ++ display(C)) ++ " * ") ++ display(M)) ++ ")" .
    eq display(C) = "SOME-C" .
}

mod! QCIRCUIT {
    pr(DISPLAY)

    [KetVec < QCircuit < Mat]

    -- [KetVec < Mat]

    -- op _|_ : Gate QCircuit -> QCircuit {r-assoc} .

    op _|_ : Gate Mat -> QCircuit {r-assoc} .

    vars G G1 G2 : Gate .
    var QC : QCircuit .
    vars M M1 M2 : Mat .
    -- eq G | QC = apply(G, QC) .
    ceq G | M = apply(G, M) if ncols(M) = 1 .
}