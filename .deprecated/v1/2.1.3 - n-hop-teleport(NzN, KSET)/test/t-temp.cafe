input ../qc.cafe .

-- set print mode normal
-- set print mode fancy
-- set print mode tree
-- set print mode s-expr

set trace on
set trace off

open GATE .
    ops a b : -> Complex .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) .
    --> 
    --> Case 1.1
    --> Teleport P0(0), P0(1)
    red getKthQubit(
        2,
        (C Z (0, 2))
        x (C X ( 1 , 2 ))
        x msment-op(P0(0))
        x msment-op(P0(1))
        x (H(0))
        x (C X ( 0 , 1 ))
        x (C X ( 1 , 2 ))
        x (H(1))
        x ((a * |0> + b * |1>) @ |0> @ |0>)
    ) .
close
-- eof

