input ../qc.cafe .
-- input ../qc-no-redundancy-old.cafe .
-- input ../qc1.0.11.cafe .

-- open GATE .

-- close

-- eof

open GATE .
    ops a b : -> Complex .

    -- vars BK BK1 BK2 BK3 : BasisKet .
    vars BK4 : BasisKet .
    vars KETPSI KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    -- eq C1 * (C2 * (C1 * KET)) = (C1 * C1) * (C2 * KET) .

    -->
    --> Teleport
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P0(0))
        x (P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    
    -- -->
    -- --> Teleport (with coefficient trick to run faster): BUT it's not faster
    -- red (cos(1/4 pi) * cos(1/4 pi)) * (
    --     C(0)Z(2)
    --     x C(1)X(2)
    --     x (P0(1) + P1(1))
    --     x (P0(0) + P1(0))
    --     x H(0) 
    --     x C(0)X(1)
    --     x C(1)X(2)
    --     x H(1)
    --     x (a * |0> + b * |1>) * |0> * |0>
    --  ) .
    
    -->
    --> Teleport (with measurement abstraction):
    red (C(0)Z(2))
        x (C(1)X(2))
        x (cos(1/4 pi) * (P0(1) + P1(1)))
        x (cos(1/4 pi) * (P0(0) + P1(0)))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x (a * |0> + b * |1>) * |0> * |0> .
    -- Normalize after measurement
    -- Checking:
    -- I * I * |psi><psi| x output

    -- Grouping M1 x K1 and M2 x K2 as M1 x K1 + M2 x K2
    -- is okay in general, I think, because:
        -- M1 x (a * K1) = a * (M1 x K1)
        -- M2 x (b * K2) = b * (M2 x K2)
        -- M1 x (a * K1) + M2 x (b * K2) = a * (M1 x K1) + b * (M2 x K2)
        
        -- M1 x (c * K1) (x) K2 = c * (M1 x (K1 (x) K2))
        -- M2 x (c * K3) (x) K4 = c * (M2 x (K3 (x) K4))
        -- [M1 x (c * K1) (x) K2] + [M2 x (c * K3) (x) K4] = c * [(M1 x (K1 (x) K2) + (M2 x (K3 (x) K4))]
    
    -- Summing side-by-side doesn't make the coefficients
    -- become confusing
    -- If it were confusing, it should be confusing from the start
    -- when we isolate the coefficient similar to the case of "c".
    -- Right from: c * (M1 x (K1 (x) K2))
    -- We don't even know c is for K1 or K2

close

eof

--> Teleport:
(
    (
        (
            cos((1/4 pi)) * (a * cos((1/4 pi)))
        ) * (|0> * (|1> * |0>))
    ) + (
        (
            cos((1/4 pi)) * (b * cos((1/4 pi)))
        ) * (|0> * (|1> * |1>))
    )
):Ket

--> Teleport (with measurement abstraction):
(
    (
        (
            (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (a * cos((1/4 pi))))
                ) * (|0> * (|0> * |0>))
            ) + (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (b * cos((1/4 pi))))
                ) * (|0> * (|0> * |1>))
            )
        ) + (
            (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (a * cos((1/4 pi))))
                ) * (|0> * (|1> * |0>))
            ) + (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (b * cos((1/4 pi))))
                ) * (|0> * (|1> * |1>))
            )
        )
    ) + (
        (
            (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (a * cos((1/4 pi))))
                ) * (|1> * (|0> * |0>))
            ) + (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (b * cos((1/4 pi))))
                ) * (|1> * (|0> * |1>))
            )
        ) + (
            (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (a * cos((1/4 pi))))
                ) * (|1> * (|1> * |0>))
            ) + (
                (
                    (cos((1/4 pi)) * cos((1/4 pi))) * (cos((1/4 pi)) * (b * cos((1/4 pi))))
                ) * (|1> * (|1> * |1>))
            )
        )
    )
):Ket

open GATE .
    op getNthQubit : Ket Nat -> Ket . --- ???
    eq getNthQubit(KET1 + KET2, K) = getNthQubit(KET1, K) + getNthQubit(KET2, K) .
    eq getNthQubit(BK, 0)       = BK .
    eq getNthQubit(BK * KET, 0) = BK .
    eq getNthQubit(BK * KET, K) = getNthQubit(KET, sd(K, 1)) .
close

-- Teleport (with measurement abstraction):
-- cos((1/4 pi))^4 = 0.25
-- 0.25 * (4 cases) = 1
(
    cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
        (
            (
                (a * (|0> * (|0> * |0>))) + (b * (|0> * (|0> * |1>)))
            ) + (
                (a * (|0> * (|1> * |0>))) + (b * (|0> * (|1> * |1>)))
            )
        ) + (
            (
                (a * (|1> * (|0> * |0>))) + (b * (|1> * (|0> * |1>)))
            ) + (
                (a * (|1> * (|1> * |0>))) + (b * (|1> * (|1> * |1>)))
            )
        )
    )
)))):Ket 

-- Teleport (with measurement abstraction and lemma):
(cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
    (
        (
            |0> * (|0> * ((a * |0>) + (b * |1>)))
        ) + (
            |0> * (|1> * ((a * |0>) + (b * |1>)))
        )
        ) + (
            (
                |1> * (|0> * ((a * |0>) + (b * |1>)))
            ) + (
                |1> * (|1> * ((a * |0>) + (b * |1>)))
            )
        )
))))):Ket

(cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (cos((1/4 pi)) * (
    (
        (|0> * (|0> + |1>)) * ((a * |0>) + (b * |1>))
    ) + (
        (|1> * (|0> + |1>)) * ((a * |0>) + (b * |1>))
    )
))))):Ket

-- (Normal) Teleport
(
    cos((1/4 pi)) * (cos((1/4 pi)) * (
        (
            a * (|0> * (|1> * |0>))
        ) + (
            b * (|0> * (|1> * |1>))
        )
    )
)):Ket

-- (Normal) Teleport with lemma
(cos((1/4 pi)) * (cos((1/4 pi)) * (
    |0> * (|1> * ((a * |0>) + (b * |1>)))
))):Ket
