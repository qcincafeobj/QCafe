    red (|psi>(2^(s(0))) ^+) x |psi>(2^(s(0))) = cos(rzero) .
close

--> Induction case
open GROVER-LEMMAS .
    op n : -> NzPNat .
    
    eq [IH] : (|psi>(2^(n)) ^+) x |psi>(2^(n)) = cos(rzero) .

    red (|psi>(2^(s(n))) ^+) x |psi>(2^(s(n))) = cos(rzero) .

close
