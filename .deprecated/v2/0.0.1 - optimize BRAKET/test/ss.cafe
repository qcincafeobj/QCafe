-- eof

set print mode s-expr

open QUANTUM-INTERPRETER .
    ops a b : -> Complex .
    
    red H(2) x (
        (
            (
                (
                    - (cos((1/4 pi)) * (cos((1/4 pi)) * b))
                ) * ((|1> @ |0>) @ (|1> @ |1>))
            ) + (
                (
                    (
                        cos((1/4 pi)) * (cos((1/4 pi)) * a)
                    ) * ((|1> @ |1>) @ (|1> @ |1>))
                ) + (
                    (
                        (
                            - (cos((1/4 pi)) * (cos((1/4 pi)) * b))
                        ) * ((|1> @ |1>) @ (|0> @ |0>))
                    ) + (
                        (
                            (
                                cos((1/4 pi)) * (cos((1/4 pi)) * a)
                            ) * ((|0> @ |0>) @ (|0> @ |0>))
                        ) + (
                            (
                                (
                                    cos((1/4 pi)) * (cos((1/4 pi)) * a)
                                ) * ((|1> @ |0>) @ (|0> @ |0>))
                            ) + (
                                (
                                    (
                                        cos((1/4 pi)) * (cos((1/4 pi)) * b)
                                    ) * ((|0> @ |0>) @ (|1> @ |1>))
                                ) + (
                                    (
                                        (
                                            cos((1/4 pi)) * (cos((1/4 pi)) * b)
                                        ) * ((|0> @ |1>) @ (|0> @ |0>))
                                    ) + (
                                        (
                                            cos((1/4 pi)) * (cos((1/4 pi)) * a)
                                        ) * ((|0> @ |1>) @ (|1> @ |1>))
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    ) .
close
-- eof
-- set trace on
open QUANTUM-INTERPRETER .
    op prog : -> Statement .
    op ketset : -> KetSet .
    op |psi> : -> Ket .
    ops a b : -> Complex .

    eq |psi> = a * |0> + b * |1> .

    eq prog = (
        H(1);
        C X (1, 2);
        C X (0, 1);
        H(0);
        C X (2, 3);
        H(2);
        I
    ) .
        -- if M(1) then X(3) else skip endif; 
        -- if M(0) then Z(3) else skip endif; 
        -- if M(2) then Z(3) else skip endif
    eq ketset = |psi> @ |0> @ |0> @ |0> .
    -- eq cos((1/4 pi)) * cos(1/4 pi) = cos(1/3 pi) .
    red execute(prog, ketset) .
close
-- set trace off
eof

set trace on
open QUANTUM-INTERPRETER .
    op prog : -> Statement .
    op ketset : -> KetSet .
    op |psi> : -> Ket .
    ops a b : -> Complex .

    eq |psi> = a * |0> + b * |1> .

    eq prog = (
        H(1);
        C X (1, 2);
        C X (0, 1);
        H(0);
        C X (2, 3);
        H(2);
        if M(1) then X(3) else skip endif; 
        if M(0) then Z(3) else skip endif; 
        if M(2) then Z(3) else skip endif
    ) .
    eq ketset = |psi> @ |0> @ |0> @ |0> .
    eq cos((1/4 pi)) * cos(1/4 pi) = cos(1/3 pi) .
    red execute(prog, ketset) .
close
set trace off

