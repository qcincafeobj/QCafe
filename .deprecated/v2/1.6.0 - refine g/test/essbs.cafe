input ../qc.cafe
set trace off

open QUANTUM-INTERPRETER .
    -- EPR @ (|0> @ |0>)
    red C X(0, 1) x H(0) x (|0> @ |0> @ |0> @ |0>) .
    
    -- EPR @ EPR
    red C X(2, 3) x H(2) x C X(0, 1) x H(0) x (|0> @ |0> @ |0> @ |0>) .

    red  C X(1, 2) x C X(2, 3) x H(2) x C X(0, 1) x H(0) x (|0> @ |0> @ |0> @ |0>) .
    (
        (cos((1/4 * pi)) * cos((1/4 * pi))) * ((|0> @ |0>) @ (|1> @ |1>)))
        + ((cos((1/4 * pi)) * cos((1/4 * pi))) * ((|1> @ |1>) @ (|0> @ |1>)))
        + ((cos((1/4 * pi)) * cos((1/4 * pi))) * ((|0> @ |0>) @ (|0> @ |0>))) 
        + ((cos((1/4 * pi)) * cos((1/4 * pi))) * ((|1> @ |1>) @ (|1> @ |0>)))
        
close
