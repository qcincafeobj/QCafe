set trace off
set trace whole off

eof
red nrows(        (
        matmul(
            tenprod(
                matmul(ket("0"),bra("0")),
                I(8)
            ),
            ket("0100")
        ) + matmul(
            tenprod(
                matmul(ket("1"),bra("1")),
                I(8)
            ),
            matmul(
                tenprod(
                    tenprod(
                        I(2),
                        (
                            matmul(ket("0"),bra("1")) 
                            + matmul(ket("1"),bra("0"))
                        )
                    ),
                    I(4)
                ),
                ket("0100")
            )
        )
    )) . -- 16

nqubits(
    (
        matmul(
            tenprod(matmul(ket("0"),bra("0")),I(8)),
            ket("0100")
        ) + matmul(
            tenprod(matmul(ket("1"),bra("1")),I(8)),
            matmul(
                tenprod(
                    tenprod(
                        I(2),
                        (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
                    ),
                    I(4)
                ),
                ket("0100")
            )
        )
    )
)

X[tidx(1)] | Ctrl(X)[cidx(0) tidx(1)] | ket("0100") = (
    apply(
        tenprod(
            I(2),
            (
                matmul(ket("0"),bra("1")) 
                + matmul(ket("1"),bra("0"))
            )
        ),
        (
            matmul(
                tenprod(
                    matmul(ket("0"),bra("0")),
                    I(8)
                ),
                ket("0100")
            ) + matmul(
                tenprod(
                    matmul(ket("1"),bra("1")),
                    I(8)
                ),
                matmul(
                    tenprod(
                        tenprod(
                            I(2),
                            (
                                matmul(ket("0"),bra("1")) 
                                + matmul(ket("1"),bra("0"))
                            )
                        ),
                        I(4)
                    ),
                    ket("0100")
                )
            )
        )
    )
):?Mat&Err

(
    (
        I(4) (x) |0><0| (x) I(2)
    ) x |0100>
    + (
        I(4) (x) |1><1| (x) I(2)
    ) x (
        (
            (|0><1| + |1><0|) (x) I(8)
        ) x |0100>
    )
)

(
    ncols(
        matmul(
            tenprod(
                tenprod(
                    I(4),
                    (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
                ),
                I(2)
            ),
            ket("0100")
        )
    )
):Nat

apply(X[tidx(2)], ket("011101")) = (
    tenprod(
        tenprod(
            I(4),
            (matmul(ket("0"),bra("1")) + matmul(ket("1"),bra("0")))
        ),
        I(8)
    )
):Mat
