-- open QCIRCUIT .
--     red (10.0) * 1 .
--     -->
--     red Ctrl(X)[cidx(0) tidx(1)] | ket("0100") .
--     red display(Ctrl(X)[cidx(0) tidx(1)] | ket("0100")) .
--     -->
--     red Ctrl(X)[tidx(0) cidx(1)] | ket("0100") .
--     red display(Ctrl(X)[cidx(0) tidx(1)] | ket("0100")) .
--     -->
--     red X[tidx(1)] | ket("0100") .
--     red display(X[tidx(1)] | ket("0100")) .
--     -->
--     red X[tidx(1)] | Ctrl(X)[cidx(0) tidx(1)] | ket("0100") .
--     red display(X[tidx(1)] | Ctrl(X)[cidx(0) tidx(1)] | ket("0100")) .
--     -->
--     red apply(P0[tidx(0)],ket("0100")) .
--     -- red apply(matmul(ket("0"),bra("0")),ket("0100")) .
--     -->
--     red ncols(ket("0100")) = 1 .
--     red X[tidx(1)] | ket("0100") .
-- close

open QCIRCUIT .
    ops a b : -> Complex .
    --> CHECK Random
    red display(X[tidx(1)] | Ctrl(X)[cidx(0) tidx(1)] | ket("0100")) .
    --> CHECK State
    red display(tenprod(a * ket("0") + b * ket("1"), ket("00"))) .
    --> CHECK ncols
    red ncols(tenprod(a * ket("0") + b * ket("1"), ket("00"))) .
    --> CHECK H State   
    -- red H[tidx(1)] | tenprod(a * ket("0") + b * ket("1"), ket("00")) .
    red display(H[tidx(1)] | tenprod(a * ket("0") + b * ket("1"), ket("00"))) .
    --> CHECK CX Entanglement
    red Ctrl(X)[cidx(1) tidx(2)] | tenprod(a * ket("0") + b * ket("1"), ket("00")) .
    red display(Ctrl(X)[cidx(1) tidx(2)] | tenprod(a * ket("0") + b * ket("1"), ket("00"))) .
    --> CHECK Unentanglement
    red H[tidx(0)] | Ctrl(X)[cidx(0) tidx(1)] | Ctrl(X)[cidx(1) tidx(2)] | H[tidx(1)] | tenprod(a * ket("0") + b * ket("1"), ket("00")) .
    red display(H[tidx(0)] | Ctrl(X)[cidx(0) tidx(1)] | Ctrl(X)[cidx(1) tidx(2)] | H[tidx(1)] | tenprod(a * ket("0") + b * ket("1"), ket("00"))) .
close

