input ../qc.cafe

open QUANTUM-INTERPRETER .
    op prog : -> Statement .
    op ketset : -> KetSet .

    eq prog = (
        H(0);
        H(2);
        C X (0, 1);
        C X (2, 3);
        C X (1, 2);
        H(1);
        if M(1) then Z(0) else skip endif;
        if M(2) then X(3) else skip endif
    ) .
    eq ketset = |0> @ |0> @ |0> @ |0> .
    red execute(prog, ketset) .
close
eof
(
    (
        (
            (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|0> @ |0>) @ (|0> @ |0>))
        ) + (
            (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|1> @ |0>) @ (|0> @ |1>))
        )
    ) V (
        (
            (
                (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|0> @ |1>) @ (|0> @ |0>))
            ) + (
                (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|1> @ |1>) @ (|0> @ |1>))
            )
        ) V (
            (
                (
                    (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|0> @ |0>) @ (|1> @ |0>))
                ) + (
                    (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|1> @ |0>) @ (|1> @ |1>))
                )
            ) V (
                (
                    (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|0> @ |1>) @ (|1> @ |0>))
                ) + (
                    (cos(rzero) / (sqrt(4) * sqrt((2 * 1/4)))) * ((|1> @ |1>) @ (|1> @ |1>))
                )
            )
        )
    )
):KetSet