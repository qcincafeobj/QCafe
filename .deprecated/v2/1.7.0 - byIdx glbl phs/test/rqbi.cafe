input ../qc.cafe
set trace on
set trace off
open QUANTUM-INTERPRETER .
    op |epr> : -> Ket .

    var BK : BasisKet .

    eq K @ removeQubitByIndex(0, BK) = K .
    eq removeQubitByIndex(N, (K1 + K2) @ K) = removeQubitByIndex(N, K1 @ K + K2 @ K) .

    eq |epr> = cos(1/4 * pi) * (|0> @ |0> + |1> @ |1>) .
    
    red removeQubitByIndex(3, |0> @ |epr> @ |1>) .
    red removeQubitByIndex(0, removeQubitByIndex(3, |0> @ |epr> @ |1>)) .
close
