input ../qc.cafe .

mod! UH-CHECKER {
    pr(QUANTUM-INTERPRETER)

    ops isUnitary isHermitian : Mat -> Bool .
    op  Imat : -> Mat .
    
    vars M M1 M2 M3 M4 : Mat .
    vars C C1 C2 : Complex .
    vars NzN : NzNat .
    vars BK BK1 BK2 : BasisKet .
    vars BB BB1 BB2 : BasisBra .

    eq Imat = |0><0| + |1><1| .
    
    eq isUnitary(M) = (
        ((M ^+) x M = Imat)
        and (M x (M ^+) = Imat)
    ) .
    
    eq isHermitian(M) = (M = M ^+) .

    -- This only well behaves in this situation 
    -- Other cases, such as H_5 x (|0><0| @ I) = H_5 x |0><0| causes bad behaviors
    eq M @ I = M . 

    eq (M1 + M2) x  M = M1 x  M + M2 x  M .
    eq (M1 + M2) @  M = M1 @  M + M2 @  M .
    eq (M1 + M2) @g M = M1 @g M + M2 @g M .
    eq M x  (M1 + M2) = M x  M1 + M x  M2 .
    eq M @  (M1 + M2) = M @  M1 + M @  M2 .
    eq M @g (M1 + M2) = M @g M1 + M @g M2 .
    -- eq M @ (M1 + M2) = M @ M1 + M @ M2 .
    eq (C1 + C2) * C = C1 * C + C2 * C .
    eq C * (C1 + C2) = C * C1 + C * C2 .

    eq (M1 @g M2) x (BK x BB) = (M1 x (BK x BB)) @g M2 .
    eq (M1 @  M2) x (BK x BB) = (M1 x (BK x BB)) @  M2 .
    eq (BK x BB)  x (M1 @ M2) = ((BK x BB) x M1) @  M2 .
    eq (M1 @  M2) @g (BK x BB) = (M1 x (BK x BB)) @  M2 . -- parallel gates
    eq I(1) x (BK x BB) = (|0><0| + |1><1|) x (BK x BB) .
    eq (M1 @ M2) x (M3 @ M4) = (M1 x M3) @ (M2 x M4) .
    eq 2 * (cos((1/4 * pi)) * cos((1/4 * pi))) = cos(rzero) .
}

--> Unitary operators
open UH-CHECKER .
    red isUnitary(X(0)) .
    red isUnitary(Y(0)) .
    red isUnitary(Z(0)) .
    red isUnitary(H(0)) .
    red isUnitary(T(0)) .
    red isUnitary(TI(0)) .
    red isUnitary(S(0)) .
    red isUnitary(SI(0)) .
    red isUnitary(C X(0, 1)) .
    
    -- P0 and P1 are not unitary
    -- red isHermitian(P0(0)) .
    -- red isHermitian(P1(0)) .
close

--> Hermitian operators
open UH-CHECKER .
    red isHermitian(X(0)) .
    red isHermitian(Y(0)) .
    red isHermitian(Z(0)) .
    red isHermitian(H(0)) .
    red isHermitian(P0(0)) .
    red isHermitian(P1(0)) .
    red isHermitian(C X(0, 1)) .

    -- T, TI = (T^+), S, and SI, are not Hermitian
    -- red isHermitian(T(0)) .
    -- red isHermitian(TI(0)) .
    -- red isHermitian(S(0)) .
    -- red isHermitian(SI(0)) .
close

open QUANTUM-INTERPRETER .
    ops a b : -> Complex .
    red C X(0, 1) x C X(0, 1) x (a * (|0> @ |0>) + b * (|1> @ |1>)) .
close

eof
(
    (
        (
            (|1> x <1|) @ (|0> x <0|)
        ) + (
            (
                |0> x <0|
            ) + (
                (|1> x <1|) @ (|1> x <1|)
            )
        )
    ) = ((|0> x <0|) + (|1> x <1|))):Bool
