input ../qc.cafe .

mod! N-HOP-TELEPORT {
    pr(PNAT)
    pr(QUANTUM-INTERPRETER)

    op teleport-pre-processor : -> Statement .
    op teleport-post-processor : -> Statement .
    op teleport-program : -> Statement .

    op n-hop-teleport : PNat -> KetSet .

    op |psi> : -> Ket .
    ops a b : -> Complex .

    vars K K1 K2 : Ket .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C C1 C2 : Complex .
    vars PN : PNat .

    eq |psi> = (a * |0> + b * |1>) .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) . -- normalization condition

    eq execute(teleport-pre-processor , K) = K @ |0> @ |0> .
    eq execute(teleport-post-processor, K) = getQubitByIndex(2, K) .

    eq teleport-program = (
        teleport-pre-processor;
        H(1);
        C X ( 1 , 2 ) ;  
        C X ( 0 , 1 ) ; 
        H(0) ; 
        if M(1) then X(2) else skip endif;
        if M(0) then Z(2) else skip endif;
        teleport-post-processor
    ) .

    eq n-hop-teleport(0) = execute(teleport-program, |psi>) .
    eq n-hop-teleport(s(PN)) = execute(
        teleport-program,
        n-hop-teleport(PN)
    ) .

    eq C * C1 + C * C2 = C * (C1 + C2) .
}
--> ==========================================================================================
--> Proof of (∀N:PNat) n-hop-teleport(N) = |psi>
--> by structural induction on N
--> ------------------------------------------------------------------------------------------
--> Base case:
--> w2s: n-hop-teleport(0) = |psi>
open N-HOP-TELEPORT .
    -- w2s
    red n-hop-teleport(0) = |psi> .
close
--> ------------------------------------------------------------------------------------------
--> Induction case: 
--> fc : (n):PNat
--> IH : n-hop-teleport(n) = |psi>
--> w2s: n-hop-teleport(s(n)) = |psi>
open N-HOP-TELEPORT .
    -- fc
    op n : -> PNat .

    -- IH
    eq [IH] : n-hop-teleport(n) = |psi> .

    -- w2s
    red n-hop-teleport(s(n)) = |psi> .
close
--> ==========================================================================================