input ../qc.cafe
set trace on
set trace off
open POST-PROCESSING .
    op |epr> : -> Ket .
    eq |epr> = cos(1/4 * pi) * (|0> @ |0> + |1> @ |1>) .

    eq (K1 + K2) @ K = K1 @ K + K2 @ K .
    red getQubitByIndex(0, |0> @ |epr> @ |1>) .
    red getQubitByIndex(3, |0> @ |epr> @ |1>) .
close
eof
g3(epr @ |1>) = 2 * (...) if distribute, must be fixed


