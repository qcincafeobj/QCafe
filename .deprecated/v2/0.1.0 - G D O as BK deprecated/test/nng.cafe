input ../qc.cafe

set trace off

mod! N-QUBIT-N-ITERATION-GROVER-SEARCH {
    -- pr(PNAT)
    pr(COMPLEX)
    pr(QUANTUM-INTERPRETER)

    op n-iter-n-qubit-grover : Nat Nat -> Ket .

    op  |psi> : Nat -> Ket .
    ops |phi0> |phi1> : Nat -> BasisKet .
    ops Imat O D G : Nat -> Mat .
    op  theta : -> Real .

    vars K K0 K1 K2 : Ket .
    vars N N1 N2 : Nat .
    vars NzN NzN1 NzN2 : NzNat .
    -- vars NzPN : NzPNat .
    vars BK : BasisKet .
    vars C : Complex .
    vars KS : KetSet .
    var  RT : Rat .
    var  R : Real .
    -- vars PN PN1 : PNat .

    -- n-qubit input constructed by Hadamard transform
    eq |psi>(N) =  (|phi0>(N) *kc cos(1/2 .* theta)) +k (|phi1>(N) *kc sin((1/2) .* theta)) .
    eq K1 +k K2 = K1 + K2 .
    eq K *kc C = C .* K .
    eq C .* RT = RT .* C .
    eq R .* RT = RT .* R .
    eq (K1 x (K2 ^+)) x K = ((K2 ^+) x K) * K1 .
    eq (|phi0>(N) ^+) x |phi0>(N) = cos(rzero) .
    eq (|phi0>(N) ^+) x |phi1>(N) = rzero .
    eq (|phi1>(N) ^+) x |phi0>(N) = rzero .
    eq (|phi1>(N) ^+) x |phi1>(N) = cos(rzero) .
    eq (cos(R) .* 2) * sin(R) = sin(2 .* R) .

    eq Imat(N) = |phi0>(N) x (|phi0>(N) ^+) + |phi1>(N) x (|phi1>(N) ^+) .
    
    eq G(N) = D(N) x O(N) .

    eq D(N) = - Imat(N) + (2 .* cos(rzero)) .* (|psi>(N)  x (|psi>(N)  ^+)) .
    eq O(N) =   Imat(N) - (2 .* cos(rzero)) .* (|phi1>(N) x (|phi1>(N) ^+)) .

    eq n-iter-n-qubit-grover(1, N) = execute(G(N), |psi>(N)) .
    eq n-iter-n-qubit-grover(NzN, N) = execute(
        G(N),
        n-iter-n-qubit-grover(p NzN, N)
    ) .
}

-- red n-qubit-grover(n) = cos((2*n + 1) * (1/2) * theta) * |phi0>(n) + ... .

--> ==========================================================================================
--> Proof of (∀N1:NzPNat)(∀N2:NzPNat) n-iter-n-qubit-grover(N1, N2)
-->                               = cos((2 * N1 + 1) * (1/2) * theta) * |phi0>(N2)
-->                               + sin((2 * N1 + 1) * (1/2) * theta) * |phi1>(N2) .
--> by structural induction on N1
--> ------------------------------------------------------------------------------------------
--> Base case:
--> w2s: n-iter-n-qubit-grover(s(0), N2)
-->      = cos((3/2) * theta) * |phi0>(N2)
-->      + sin((3/2) * theta) * |phi1>(N2) .
-- set print mode tree
-- set print mode normal
-- open N-QUBIT-N-ITERATION-GROVER-SEARCH .
--     red 2 * sin(1/2 * theta) .
--     red ((((sin(theta) * ((sin((1/2 * theta)) * (2 * -1)) + sin((1/2 * theta)))) + ((2 * (cos((1/2 * theta)) * (cos((1/2 * theta)) * cos((1/2 * theta))))) + (cos((1/2 * theta)) * -1))) * |phi0>(N2)) + (((((sin((1/2 * theta)) * (2 * -1)) + sin((1/2 * theta))) * -1) + ((2 * ((sin((1/2 * theta)) + (sin((1/2 * theta)) * (2 * -1))) * (sin((1/2 * theta)) * sin((1/2 * theta))))) + (cos((1/2 * theta)) * sin(theta)))) * |phi1>(N2))) .
-- close
-- eof

open N-QUBIT-N-ITERATION-GROVER-SEARCH .
    -- w2s
    -- red n-iter-n-qubit-grover(1, N2)
    --     = cos((3/2) * theta) * |phi0>(N2)
    --     + sin((3/2) * theta) * |phi1>(N2) .
    red 2 - 2 .
    red cos(5 pi) .* |0> + cos(3 pi) .* |1> .
    red n-iter-n-qubit-grover(1, N2) .
close
eof
(((|1> @ (
    |1> + (
        (
            -1 * (
                (
                    cos((1/4 pi)) + (cos((1/4 pi)) * -1)
                ) * cos((1/4 pi))
            )
        ) * |1>)
    )
) V ((|0> @ (|1> + ((cos((1/4 pi)) * (cos((1/4 pi)) + (cos((1/4 pi)) * -1))) * |1>))) V ((|0> @ (|0> + ((cos((1/4 pi)) * (cos((1/4 pi)) + (cos((1/4 pi)) * -1))) * |0>))) V (|1> @ (|0> + ((-1 * ((cos((1/4 pi)) + (cos((1/4 pi)) * -1)) * cos((1/4 pi)))) * |0>)))))) = ((|1> @ |1>) V ((|1> @ |0>) V ((|0> @ |1>) V (|0> @ |0>))))):Bool
eof

--> ------------------------------------------------------------------------------------------
--> Induction case: 
--> fc : (n):NzPNat
--> IH : n-iter-n-qubit-grover(n, N2)
-->      = cos((2 * n + 1) * (1/2) * theta) * |phi0>(N2)
-->      + sin((2 * n + 1) * (1/2) * theta) * |phi1>(N2) .
--> w2s: n-iter-n-qubit-grover(s(n), N2)
-->      = cos((2 * n + 3) * (1/2) * theta) * |phi0>(N2)
-->      + sin((2 * n + 3) * (1/2) * theta) * |phi1>(N2) .
open N-QUBIT-N-ITERATION-GROVER-SEARCH .
    -- fc
    op n : -> NzNat .

    -- IH
    eq [IH] : n-iter-n-qubit-grover(n, NzN2)
              = cos((2 * n + 1) * (1/2) * theta) * |phi0>(NzN2)
              + sin((2 * n + 1) * (1/2) * theta) * |phi1>(NzN2) .

    -- w2s
    red n-iter-n-qubit-grover(n + 1, NzN2)
        = cos((2 * n + 3) * (1/2) * theta) * |phi0>(NzN2)
        + sin((2 * n + 3) * (1/2) * theta) * |phi1>(NzN2) .
close
--> ==========================================================================================

-- 
(
    (
        (
            (
                sin(theta) * (
                    (
                        - (sin((1/2 * theta)) * 2)
                    ) + sin((1/2 * theta))
                )
            ) + (
                (
                    cos((1/2 * theta)) * (
                        cos((1/2 * theta)) * (
                            cos((1/2 * theta)) * 2
                        )
                    )
                ) + (- cos((1/2 * theta)))
            )
        ) * |phi0>(N2)
    ) + (((- ((- (sin((1/2 * theta)) * 2)) + sin((1/2 * theta)))) + ((sin((1/2 * theta)) * (sin((1/2 * theta)) * (((- (sin((1/2 * theta)) * 2)) + sin((1/2 * theta))) * 2))) + (cos((1/2 * theta)) * sin(theta)))) * |phi1>(N2))):Ket

(
    (
        (
            (
                sin(theta) * ((- (sin((1/2 * theta)) * 2)) + sin((1/2 * theta)))
            ) + (
                (
                    cos((1/2 * theta)) * (
                        cos((1/2 * theta)) * (cos((1/2 * theta)) * 2)
                    )
                ) + (- cos((1/2 * theta)))
            )) * |phi0>(N2)
    ) + (((- ((- (sin((1/2 * theta)) * 2)) + sin((1/2 * theta)))) + ((sin((1/2 * theta)) * (sin((1/2 * theta)) * (((- (sin((1/2 * theta)) * 2)) + sin((1/2 * theta))) * 2))) + (cos((1/2 * theta)) * sin(theta)))) * |phi1>(N2))):Ket

(
    (
        (
            (
                sin(theta) * (
                    (2 * (- sin((1/2 * theta)))) + sin((1/2 * theta))
                )
            ) + (
                (cos((1/2 * theta)) * (cos((1/2 * theta)) * (cos((1/2 * theta)) * 2)))
                + (- cos((1/2 * theta)))
            )
        ) * |phi0>(N2)
    ) + (((- ((2 * (- sin((1/2 * theta)))) + sin((1/2 * theta)))) + ((sin((1/2 * theta)) * (sin((1/2 * theta)) * (((2 * (- sin((1/2 * theta)))) + sin((1/2 * theta))) * 2))) + (cos((1/2 * theta)) * sin(theta)))) * |phi1>(N2))):Ket


(
    (
        (
            (
                - cos((1/2 * theta))
            ) + (
                2 * (
                    cos((1/2 * theta)) * (
                        (
                            cos((1/2 * theta)) * cos((1/2 * theta))
                        ) + (
                            cos(((1/2 * (- theta)) + (1/2 pi))) * (
                                cos(((1/2 pi) + (1/2 * (- theta)))) + (
                                    2 * (- cos(((1/2 * (- theta)) + (1/2 pi))))
                                )
                            )
                        )
                    )
                )
            )
        ) * |phi0>(N2)
    ) + (((- (cos(((1/2 pi) + (1/2 * (- theta)))) + (2 * (- cos(((1/2 * (- theta)) + (1/2 pi))))))) + (2 * (cos(((1/2 pi) + (1/2 * (- theta)))) * ((cos((1/2 * theta)) * cos((1/2 * theta))) + (cos(((1/2 pi) + (1/2 * (- theta)))) * ((2 * (- cos(((1/2 pi) + (1/2 * (- theta)))))) + cos(((1/2 * (- theta)) + (1/2 pi))))))))) * |phi1>(N2))):Ket


(
    (
        (
            (
                sin(theta) * (
                    (
                        2 * (- sin((1/2 * theta)))
                    ) + sin((1/2 * theta))
                )
            ) + (
                (
                    cos((1/2 * theta)) * (cos((1/2 * theta)) * (cos((1/2 * theta)) * 2))
                ) + (- cos((1/2 * theta)))
            )
        ) * |phi0>(N2)
    ) + (((- ((2 * (- sin((1/2 * theta)))) + sin((1/2 * theta)))) + ((sin((1/2 * theta)) * (sin((1/2 * theta)) * (((2 * (- sin((1/2 * theta)))) + sin((1/2 * theta))) * 2))) + (cos((1/2 * theta)) * sin(theta)))) * |phi1>(N2))):Ket