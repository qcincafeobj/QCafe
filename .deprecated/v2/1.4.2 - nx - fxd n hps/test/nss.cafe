input ../qc.cafe
set trace on
set trace off
mod! N-HOP-QUANTUM-SECRET-SHARING {
    pr(PNAT)
    pr(QUANTUM-INTERPRETER)

    op qss-pre-processor : -> Statement .
    op qss-post-processor : -> Statement .
    op qss-program : -> Statement .

    op getKthQubit : Nat Ket -> Ket .
    -- op correctGlobalPhase : Ket -> Ket .
    
    op n-hop-qss : PNat -> KetSet .

    op |psi> : -> Ket .
    ops a b : -> Complex .

    vars K K1 K2 : Ket .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C C1 C2 : Complex .
    vars KSET : KetSet .
    vars NzPN : NzPNat .

    eq |psi> = (a * |0> + b * |1>) .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) . -- normalization condition

    eq execute(qss-pre-processor , K) = K @ |0> @ |0> @ |0> .
    eq execute(qss-post-processor, K) = getKthQubit(3, K) .
    -- eq execute(qss-post-processor, K) = correctGlobalPhase(getKthQubit(3, K)) .

    eq getKthQubit(N, K1 + K2) = getKthQubit(N, K1) + getKthQubit(N, K2) .
    eq getKthQubit(NzN, BK @ K)  = getKthQubit(p NzN, K) .
    eq getKthQubit(0, BK @ K)    = BK .
    eq getKthQubit(0, BK)          = BK .
    eq getKthQubit(N, C * K)     = C * getKthQubit(N, K) .

    -- eq correctGlobalPhase((- a) * |0> + (- b) * |1>) = |psi> .
    -- eq correctGlobalPhase(   a  * |0> +    b  * |1>) = |psi> .

    -- Regarding GHZ state, both methods below are valid:
    -- H(0); C X (0, 1); C X (0, 2)
    -- H(0); C X (0, 1); C X (1, 2)

    eq qss-program = (
        qss-pre-processor;
        H(1);
        C X (1, 2);
        C X (0, 1);
        H(0);
        C X (2, 3);
        H(2);
        if M(1) then X(3) else skip endif; 
        if M(0) then Z(3) else skip endif; 
        if M(2) then Z(3) else skip endif;
        qss-post-processor
    ) .

    -- n hops >= 1
    eq n-hop-qss(s(0)) = execute(qss-program, |psi>) .
    eq n-hop-qss(s(NzPN)) = execute(
        qss-program,
        n-hop-qss(NzPN)
    ) .

    -- eq [additional-rule] : sqrt(4) = 2 * cos(rzero) .
    eq C / sqrt(1/4) = C * sqrt(4) .
    
    eq C * C1 + C * C2 = C * (C1 + C2) .

    -- implicitly correcting global phase
    eq ((K1 V K2) = K) = (
        (
            (K1 = K) or (K1 = - K)
        ) and (
            (K2 = K) or (K2 = - K)
        )
    ) .
}

--> ==========================================================================================
--> Proof of (∀N:PNat) n-hop-qss(N) = |psi>
--> by structural induction on N
--> ------------------------------------------------------------------------------------------
--> Base case:
--> w2s: n-hop-qss(s(0)) = |psi>
open N-HOP-QUANTUM-SECRET-SHARING .
    -- w2s
    red n-hop-qss(s(0)) = |psi> .
close
--> ------------------------------------------------------------------------------------------
--> Induction case: 
--> fc  : (n):NzPNat
--> IH  : n-hop-qss(n) = |psi>
--> w2s : n-hop-qss(s(n)) = |psi>
open N-HOP-QUANTUM-SECRET-SHARING .
    -- fc
    op n : -> NzPNat .

    -- IH
    eq [IH] : n-hop-qss(n) = |psi> .

    -- w2s
    red n-hop-qss(s(n)) = |psi> .
close
--> ==========================================================================================