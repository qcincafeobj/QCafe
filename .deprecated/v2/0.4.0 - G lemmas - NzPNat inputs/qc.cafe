mod! PNAT {
    pr(BOOL)
    
    [PZero NzPNat < PNat]
    op 0 : -> PZero .
    -- op pnzero : -> PZero .
    op s : PNat -> NzPNat .
    op p : NzPNat -> PNat .

    op _+_ : PNat PNat -> PNat {prec: 33 assoc comm} .
    op _=_  : PNat PNat -> Bool {prec: 51 comm} .
    
    vars X Y : PNat .
    
    eq (s(X) = 0) = false .
    -- eq (s(X) = pnzero) = false .
    -- eq (pnzero = s(X)) = false .

    -- eq (pnzero = 0) = true .

    -- eq pnzero + Y = Y .
    eq 0 + Y = Y .
    eq s(X) + Y = s(X + Y) .   
}

mod! REAL {
    pr(BOOL)
    pr(NAT)
    pr(RAT)
    [RZero NzReal < Real]
    [Nat < Rat]

    op -_ : Real -> Real {prec: 15} .

    op _+_ : Real Real -> Real {prec: 33 assoc comm} .
    op _-_ : Real Real -> Real {prec: 33 l-assoc} .
    op _*_ : Real Real -> Real {prec: 31 assoc comm} .
    op _/_ : Real Real -> Real {prec: 31 l-assoc} .
        
    op _=_  : Real Real -> Bool {prec: 51 comm} .
    op _=_  : Real RZero -> Bool {prec: 51} .
    op _=_  : RZero Real -> Bool {prec: 51} .
    op _=_  : RZero RZero -> Bool {prec: 51 comm} .
    op _>_  : Real Real -> Bool {prec: 51} .
    op _<_  : Real Real -> Bool {prec: 51} .
    op _>=_ : Real Real -> Bool {prec: 51} .
    op _<=_ : Real Real -> Bool {prec: 51} .

    op rzero : -> RZero .

    op _ pi : Rat -> Real .
    op cos : Real -> Real .
    op sin : Real -> Real {prec: 15} .
    -- op Cos : Real -> Real .
    -- ceq Cos(theta) = ?
    -- ceq cos(RT pi) = cos(RT * pi) ...
    -- op Sin : Real -> Real {prec: 15} .

    vars R R1 R2 R3 : Real .
    vars RT RT1 RT2 : Rat .
    vars NzRT : NzRat .
    
    eq - (RT pi) = (- RT) pi .
    eq - (- R) = R .
    eq - rzero = rzero .

    eq (RT1 pi) + (RT2 pi) = (RT1 + RT2) pi .
    eq R + rzero = R .
    eq R + (- R) = rzero .

    eq R1 - R2 = R1 + (- R2) .
    eq rzero * R = rzero .
    
    -- Built toward cosine and angles in the range [0, pi / 2]
    eq 0 pi = rzero .
    
    eq sin(RT pi) = cos((1/2 - RT) pi) .            -- sin(x) = cos(pi/2 - x)
    -- eq sin(R) = cos(R - (1/2 pi)) .            -- sin(x) = cos(pi/2 - x)

    eq cos(1/2 pi) = rzero .
    eq R * cos(rzero) = R .
    eq cos(rzero) * R = R .
    eq cos(1 pi) = - cos(rzero) .
    eq R * (- cos(rzero)) = - R .
    eq (- cos(rzero)) * R = - R .
    
    eq (RT * cos(rzero)) * R = RT * R .
    
    ceq - cos(RT pi) = cos((1 - RT) pi) if (RT > 1/2) .            -- cos(pi - x) = - cos(x)

    -- theta > pi <=> theta - 2pi > -pi
    ceq cos(RT pi) = cos((RT - 2) pi) if RT > 1 .   -- cos(x - 2pi) = cos(x)
    ceq cos(RT pi) = cos((- RT) pi)    if RT < 0 .  -- cos(-x) = cos(x)
    
    -- (0 < R1, R2 < pi) and (R1 \neq R2)
    ceq (cos(R1) = cos(R2)) = false if (
        ((rzero < R1) and (R1 < (1 pi)))
        and ((rzero < R2) and (R2 < 1 pi))
        and ((R1 = R2) = false)
    ) .
    eq (- cos(rzero) = cos(rzero)) = false .
    ceq ((R1 * R2) = rzero) = false if false = ((R1 = rzero) or (R2 = rzero)) .
    ceq ((R1 + R2) = rzero) = false if (- R1 = R2) = false .

    eq rzero >  rzero = false .
    eq rzero >= rzero = true .
    eq rzero <  rzero = false .
    eq rzero <= rzero = true .

    eq (cos(rzero) =  rzero) = false .
    eq (cos(rzero) >  rzero) = true .
    eq (cos(rzero) >= rzero) = true .
    eq (cos(rzero) <  rzero) = false .
    eq (cos(rzero) <= rzero) = false .
    
    eq (- cos(rzero) =  rzero) = false .
    eq (- cos(rzero) >  rzero) = false .
    eq (- cos(rzero) >= rzero) = false .
    eq (- cos(rzero) <  rzero) = true .
    eq (- cos(rzero) <= rzero) = true .

    ceq (cos(R) = rzero) = false if (rzero <= R) and (R < 1/2 pi) .    -- 1st quadrant
    ceq (cos(R) = rzero) = false if (1/2 pi < R) and (R <= 1 pi) .     -- 2nd quadrant

    ceq (cos(R) >  rzero) = true if (rzero  <  R) and (R <  1/2 pi) .  -- 1st quadrant
    ceq (cos(R) >= rzero) = true if (rzero  <= R) and (R <= 1/2 pi) .  -- 2nd quadrant
    ceq (cos(R) <  rzero) = true if (1/2 pi <  R) and (R <    1 pi) .  -- 1st quadrant
    ceq (cos(R) <= rzero) = true if (1/2 pi <= R) and (R <=   1 pi) .  -- 2nd quadrant
    
    ceq (cos(R) >  rzero) = false if (1/2 pi <= R) and (R <=   1 pi) . -- 2nd quadrant
    ceq (cos(R) >= rzero) = false if (1/2 pi <  R) and (R <    1 pi) . -- 1st quadrant
    ceq (cos(R) <  rzero) = false if (rzero  <= R) and (R <= 1/2 pi) . -- 2nd quadrant
    ceq (cos(R) <= rzero) = false if (rzero  <  R) and (R <  1/2 pi) . -- 1st quadrant

    eq RT1 pi >  RT2 pi = if (RT1 >  RT2) then true else false fi .
    eq RT1 pi >= RT2 pi = if (RT1 >= RT2) then true else false fi .
    eq RT1 pi <  RT2 pi = if (RT1 <  RT2) then true else false fi .
    eq RT1 pi <= RT2 pi = if (RT1 <= RT2) then true else false fi .
    
    eq RT pi >  rzero = if (RT >  0) then true else false fi .
    eq RT pi >= rzero = if (RT >= 0) then true else false fi .
    eq RT pi <  rzero = if (RT <  0) then true else false fi .
    eq RT pi <= rzero = if (RT <= 0) then true else false fi .
    
    eq rzero >  RT pi = if (0 >  RT) then true else false fi .
    eq rzero >= RT pi = if (0 >= RT) then true else false fi .
    eq rzero <  RT pi = if (0 <  RT) then true else false fi .
    eq rzero <= RT pi = if (0 <= RT) then true else false fi .

    op _*_ : Rat Real -> Real {prec: 31} .
    op _*_ : Real Rat -> Real {prec: 31} .
    -- eq (RT1 * R1) * (RT2 * R2) = (RT1 * RT2) * (R1 * R2) .
    -- eq R1 * (RT * R2) = RT * (R1 * R2) .
    -- eq RT * (R1 + R2) = RT * R1 + RT * R2 .
    eq R * RT = RT * R .
    -- eq (RT * cos(rzero)) * R = RT * R .
    -- eq R + RT * R = (1 + RT) * R .
    -- eq R1 * R + R2 * R = (R1 + R2) * R .

    -- eq (- R) + R * R1 = (R1 - cos(rzero)) * R . -- t
    
    -- eq R * (R1 + R2) = R * R1 + R * R2 .
    -- eq (- R) + RT * R = (RT - 1) * R .

    -- op _*_ : Real NzInt -> Real {prec: 31} .
    -- op _*_ : NzInt Real -> Real {prec: 31} .

    -- eq RT * (- R) = (- RT) * R .
    -- eq - R = ((-1) - 0) * R .
    eq (R1 / R2) * R3 = (R1 * R3) / R2 .
    eq (R1 / R2) / R = R1 / (R2 * R) .
    ceq R / R = cos(rzero) if ((R = rzero) = false) .
    ceq (R1 + R2 > rzero) = true if ((R1 > rzero) and (R2 > rzero)) .

    eq R1 / R + R2 / R = (R1 + R2) / R .
    eq - (R1 / R) + R2 / R = (- R1 + R2) / R .
    -- eq R1 * (R2 * RT) = RT * (R1 * R2) .

    eq cos(R) * cos(R) + sin(R) * sin(R) = cos(rzero) .
    eq 2 * (sin(R) * cos(R)) = sin(2 * R) .                             -- double-angle formula
    eq cos(R) * (sin(R) * 2) = sin(2 * R) .                             -- double-angle formula
    eq 2 * (cos(R) * cos(R)) + (- cos(rzero)) = cos(2 * R) .            -- double-angle formula
    eq cos(R) * (cos(R) * 2) + (- cos(rzero)) = cos(2 * R) .            -- double-angle formula
    eq 2 * (sin(R) * sin(R)) + (- cos(rzero)) = - cos(2 * R) .          -- double-angle formula
    eq sin(R) * (sin(R) * 2) + (- cos(rzero)) = - cos(2 * R) .          -- double-angle formula
    eq cos(R1) * cos(R2) + (- (sin(R1) * sin(R2))) = cos(R1 + R2) .     -- addition formula
    eq sin(R1) * cos(R2) + cos(R1) * sin(R2) = sin(R1 + R2) .           -- addition formula
    
}

mod! COMPLEX {
    pr(BOOL)
    pr(NAT)
    pr(RAT)
    pr(REAL)
    
    [Real Imaginary < Complex]

    op -_ : Complex -> Complex {prec: 15} .

    op _+_ : Complex Complex -> Complex {prec: 33 assoc comm} .
    op _-_ : Complex Complex -> Complex {prec: 33 l-assoc} .
    op _*_ : Complex Complex -> Complex {prec: 31 assoc comm} .
    op _/_ : Complex Complex -> Complex {prec: 31 l-assoc} .

    op _*_ : Complex Rat -> Complex {prec: 31 assoc} .
    op _*_ : Rat Complex -> Complex {prec: 31 assoc} .
    
    op _/_ : Complex Rat -> Complex {prec: 31 l-assoc} .

    op _+_ : Real Imaginary -> Complex {prec: 33 assoc comm} .
    op _+_ : Imaginary Real -> Complex {prec: 33 assoc comm} .
    op _+_ : Imaginary Imaginary -> Imaginary {prec: 33 assoc comm} .
    op _^* : Complex -> Complex .

    op _=_  : Complex Complex -> Bool {prec: 51 comm} .
    op _=_  : Complex RZero -> Bool {prec: 51} .
    op _>_  : Complex Complex -> Bool {prec: 51} .
    op _<_  : Complex Complex -> Bool {prec: 51} .
    op _>=_ : Complex Complex -> Bool {prec: 51} .
    op _<=_ : Complex Complex -> Bool {prec: 51} .

    op i_ : Real -> Imaginary .
    op e^_ : Complex -> Complex .

    op sqrt : Complex -> Complex .
    op sqrt : Rat -> Complex .

    vars C C1 C2 C3 : Complex .
    vars R R1 R2 : Real .
    vars RT RT1 RT2 : Rat .
    vars NzRT : NzRat .

    -- identity element
    eq C * cos(rzero) = C .

    -- constructor
    eq i rzero = rzero .
    
    -- negative elements
    eq - (- C) = C .
    eq C + (- C) = rzero .
    eq - i R   = i (- R) .

    -- addition, substraction
    eq rzero + C   = C .
    eq i R1 + i R2 = i (R1 + R2) .
    eq i R1 - i R2 = i (R1 - R2) .
    
    -- multiplication, division
    eq rzero * C       = rzero .
    eq R1 * (i R2)     = i (R1 * R2) .
    eq (i R1) * (i R2) = - (R1 * R2) .
    
    eq C1 * (C2 / C3) = (C1 * C2) / C3 .
    eq (C1 / C2) * C3 = (C1 * C3) / C2 .
    eq (C1 / C2) / C3 = C1 / (C2 * C3) .
    ceq (R * C) / R = C if (R = rzero) = false .
    eq (C1 * C2) / (C1 * C3) = (C1 / C1) * (C2 / C3) .
    eq C1 / (C1 * C2) = (C1 / C1) * (cos(rzero) / C2) .

    eq (RT * C = rzero) = ((C = rzero) or (RT = 0)) .
    ceq (C / C) = cos(rzero) if ((C = rzero) = false) .

    eq C / cos(rzero) = C .
    eq (C1 / C) + (C2 / C) = (C1 + C2) / C .

    -- conjugate
    eq R ^*     = R .
    eq (i R) ^* = i (- R) .
    eq (R1 + (i R2)) ^* = R1 + (i (- R2)) .
    eq (- C) ^* = - (C ^*) .
    eq (C1 / C2)^* = (C1 ^*) / (C2 ^*) .
    eq (C1 * C2)^* = (C1 ^*) * (C2 ^*) .
    eq (C1 + C2)^* = (C1 ^*) + (C2 ^*) .

    eq (C ^*) ^* = C .
    -- eq (C * RT) ^* = (C ^*) * RT .
    eq (C * RT) ^* = RT * (C ^*) .
    eq (RT * C) ^* = RT * (C ^*) .
    
    -- Euler formula
    eq e^(i R)  = cos(R) + (i sin(R)) .

    -- coefficient isolation
    eq C * C1 + C * C2 = C * (C1 + C2) .
    eq C + C = (2 * cos(rzero)) * C .
    eq RT * C1 + RT * C2 = RT * (C1 + C2) .
    eq (RT * C1) * C2 = RT * (C1 * C2) .
    eq C1 * (RT * C2) = RT * (C1 * C2) .
    
    eq C1 / (NzRT * C2) = (1 / NzRT) * (C1 / C2) .
    eq (RT * C1) / C2 = RT * (C1 / C2) .
    eq RT1 * (RT2 * C) = (RT1 * RT2) * C .
    eq (C1 * RT) / C2 = RT * (C1 / C2) .
    eq 1 * C = C .
    eq - (RT * C) = RT * (- C) .
    -- eq - (C * RT) = (- C) * RT .
    eq - (C * RT) = RT * (- C) .
    
    -- square root
    eq sqrt(C) * sqrt(C) = C .
    ceq (R * C) / sqrt(R) = sqrt(R) * C if (R = rzero) = false .
    eq sqrt(C1 * C2) = sqrt(C1) * sqrt(C2) .
    eq sqrt(C1 / C2) = sqrt(C1) / sqrt(C2) .
    eq sqrt(cos(rzero)) = cos(rzero) .

    eq sqrt(RT * C) = sqrt(RT) * sqrt(C) .
    eq sqrt(C * RT) = sqrt(RT) * sqrt(C) .
    eq (sqrt(C))^* = sqrt(C ^*) .
    ceq (sqrt(R))^* = sqrt(R) if (R > rzero) .
    ceq (sqrt(RT))^* = sqrt(RT) if (RT > 0) .
    eq sqrt(RT) * sqrt(RT) = RT * cos(rzero) .
    eq sqrt(RT1) * sqrt(RT2) = sqrt(RT1 * RT2) .
    eq sqrt(1) = cos(rzero) .
    ceq sqrt(RT) / sqrt(RT) = cos(rzero) if (RT > - RT) .
    
    -- negative element
    eq (- C1) * C2 = - (C1 * C2) .
    eq (- C1) / C2 = - (C1 / C2) .

    eq (C1 * C2 = rzero) = (C1 = rzero) or (C2 = rzero) .
    eq (C * RT = rzero) = (C = rzero) or (not (RT > 0 and RT < 0)) .
    -- ceq - C = (- cos(rzero)) * C if (C = cos(rzero)) = false .

    -- eq C1 * (RT * C2) = RT * (C1 * C2) .
}

mod! BRAKET {
    pr(BOOL)
    pr(NAT)
    pr(RAT)
    pr(REAL)
    pr(COMPLEX)

    [BasisBra BraZero < Bra]
    [BasisKet KetZero < Ket]

    [BasisKetBra < Mat]
    
    ops <0| <1| : -> BasisBra .
    ops |1> |0> : -> BasisKet .
    ops |0><0| |0><1| |1><0| |1><1| : -> BasisKetBra .
    op bO : -> BraZero . -- [ 0 0 ] = O
    op kO : -> KetZero . -- [ 0 0 ]^T = kO

    op ||_||^2 : Ket -> Real .
    op _=_ : Bra Bra -> Bool {prec: 51 comm} .
    op _=_ : Ket Ket -> Bool {prec: 51 comm} .

    op _^+ : Ket -> Bra {prec: 15} .                    -- dagger/conjugate transpose
    op _^+ : BasisKet -> BasisBra {prec: 15} .          -- dagger/conjugate transpose
    op -_  : Ket -> Ket {prec: 15} .
    op -_  : BasisKet -> BasisKet {prec: 15} .
    op _+_ : Ket Ket -> Ket {prec: 33 assoc comm} .
    op _+_ : Bra Bra -> Bra {prec: 33 assoc comm} .
    
    -- op _+k_ : Ket Ket -> Ket {prec: 33 assoc comm} .
    
    -- _*_ : tenprod, Complex * Mat
    op _@_ : Ket Ket -> Ket {prec: 31 assoc} .          -- tenprod |_> (x) |_>
    op _@_ : Bra Bra -> Bra {prec: 31 assoc} .          -- tenprod <_| (x) <_|
    op _*_ : Complex Bra -> Bra {prec: 31} .
    op _*_ : Complex Ket -> Ket {prec: 31} .
    -- op _*kc_ : Ket Complex -> Ket {prec: 31} .
    
    -- _x_ : innprod, outprod, matmul
    op _x_ : Bra Ket -> Complex {prec: 31 assoc} .      -- innprod   <_|_>
    op _x_ : Ket Bra -> Mat {prec: 31 assoc} .          -- outerprod |_><_|
    
    op -_  : Mat -> Mat {prec: 15} .
    op _+_ : Mat Mat -> Mat {prec: 33 assoc comm} .
    op _-_ : Mat Mat -> Mat {prec: 33 l-assoc} .
    op _x_ : Mat Mat -> Mat {prec: 31 assoc} .          -- matmul
    op _@_ : Mat Mat -> Mat {prec: 31 assoc} .          -- tenprod, to be checked
    
    op _*_ : Rat Mat -> Mat {prec: 31} .
    op _*_ : Complex Mat -> Mat {prec: 31} .
    op _x_ : Mat Ket -> Ket {prec: 31 r-assoc} .        -- matmul with Ket

    vars BB : BasisBra .
    vars BK BK1 : BasisKet .
    vars B B1 B2 : Bra .
    vars K K1 K2 : Ket .
    vars M M1 M2 M3 : Mat .
    vars C C1 C2 : Complex .
    vars R R1 R2 : Real .
    vars RT : Rat .

    -- norm squared
    eq || K ||^2 = (K ^+) x K .

    -- bra equalities
    eq (<0| = <0|) = true .
    eq (<0| = <1|) = false .
    eq (<1| = <0|) = false .
    eq (<1| = <1|) = true .

    -- dagger/conjugate transpose
    eq |0> ^+ = <0| .
    eq |1> ^+ = <1| .
    eq (K1 + K2)^+ = (K1 ^+) + (K2 ^+) .
    eq (K1 @ K2)^+ = (K1 ^+) @ (K2 ^+) .
    eq (C * K)^+   = (C ^*) * (K ^+) .

    -- outprod in orthogonal bases
    ceq BB x BK = cos(rzero) if (BK ^+ = BB) .
    ceq BB x BK = rzero if (BK ^+ = BB) = false .
    eq |0><0| = |0> x <0| .
    eq |0><1| = |0> x <1| .
    eq |1><0| = |1> x <0| .
    eq |1><1| = |1> x <1| .

    -- handling kO = [0 0]^T
    eq rzero * K = kO .
    eq - kO      = kO .
    eq kO @ K    = kO .
    eq K @ kO    = kO .
    eq C * kO    = kO .
    eq kO + K    = K .
    eq M x kO    = kO .

    -- substraction
    eq M1 - M2 = M1 + (- M2) .

    -- matmul
    eq (BK x BB) x BK1   = (BB x BK1) * BK .
    eq (M1 x M2) x K     = M1 x (M2 x K) .

    -- distribition of operators into addition
    eq C * (K1 + K2) = C * K1 + C * K2 .
    -- eq (C * C1) * K1 + (C * C2) * K2 = C * (C1 * K1 + C2 * K2) .
    eq C1 * K + (- C1) * K = kO .

    eq M x (K1 + K2)   = M x K1 + M x K2 .
    eq (M1 + M2) x K    = M1 x K + M2 x K .
    eq (M1 + M2) @ M3   = M1 @ M3 + M2 @ M3 .
    
    -- eq (K1 + K2) @ K = K1 @ K + K2 @ K .
    -- eq K @ (K1 + K2) = K @ K1 + K @ K2 .

    eq (K1 + K2) x B = K1 x B + K2 x B . -- nqss: can ignore
    eq K x (B1 + B2) = K x B1 + K x B2 . -- nqss: can ignore

    eq (B1 + B2) @ B = B1 @ B + B2 @ B .
    eq B x ((K1 + K2) @ K) = B x (K1 @ K + K2 @ K) .

    eq (B1 + B2) x K = B1 x K + B2 x K .
    eq B x (K1 + K2) = B x K1 + B x K2 .

    eq RT * (M1 + M2) = RT * M1 + RT * M2 .

    -- complex coefficient isolation
    eq cos(rzero) * K = K .
    eq K1 @ (C * K2)  = C * (K1 @ K2) .
    eq (C * K1) @ K2  = C * (K1 @ K2) .
    eq (C * M) x K    = C * (M x K) .
    eq M x (C * K)    = C * (M x K) .
    eq (C * M1) @ M2  = C * (M1 @ M2) .
    eq C1 * (C2 * K)  = (C1 * C2) * K .

    eq K x (C * B) = C * (K x B) .
    eq (C * K) x B = C * (K x B) .
    
    eq B x (C * K) = C * (B x K) .
    eq (C * B) x K = C * (B x K) .

    eq C1 * K + C2 * K = (C1 + C2) * K .
    
    eq B1 @ (C * B2)   = C * (B1 @ B2) .
    eq (C * B1) @ B2   = C * (B1 @ B2) .

    -- eq C1 * B + C2 * B = (C1 + C2) * B .

    -- innprod
    eq (BB @ B) x (BK @ K) = (BB x BK) * (B x K) .

    -- negative elements
    eq - M = (- cos(rzero)) * M .
    eq - K = (- cos(rzero)) * K .

    -- eq (RT * cos(rzero)) * (C * M) = (RT * C) * M .
    eq C * (M1 + M2) = C * M1 + C * M2 . -- t

    -- eq C1 * (K1 @ K) + C2 * (K2 @ K) = (C1 * K1 + C2 * K2) @ K .
    -- eq C1 * (K @ K1) + C2 * (K @ K2) = K @ (C1 * K1 + C2 * K2) .

    eq C1 * M + C2 * M = (C1 + C2) * M .
    eq C1 * (C2 * M) = (C1 * C2) * M .
    -- eq R1 * M + R2 * M = (R1 + R2) * M .
}

mod! NATLIST {
    pr(NAT)
    -- a lite version for NatList (with no empty list)

    [NatList]
    op _ _ : Nat Nat -> NatList .
    op _ _ : Nat NatList -> NatList .
}

mod! GATE {
    -- pr(BOOL)
    -- pr(NAT)
    pr(RAT)
    pr(REAL)
    pr(COMPLEX)
    pr(NATLIST)
    pr(BRAKET)
    
    [Gate ControlledGate < Mat]
    [GateName]
    [Measurement Normalizer < MetrologyHandler]
    [ParallelMat < Mat]

    -- gates supported
    ops X Y Z H P0 P1 : -> GateName .
    ops S SI T TI : -> GateName .
    op _ _ : GateName Nat -> Gate {prec: 15} .
    
    -- controlled and multi-controlled mechanisms
    op C _ ( _ , _ ) : GateName Nat Nat -> ControlledGate {prec: 13} .
    op MC_ ( [ _ ] , _ ) : GateName NatList Nat -> ControlledGate {prec: 13} .

    op I : Nat -> Gate .    -- I(N): identity gate for N qubits
    op I : -> Gate .        -- Dimension helper: General identity gate, contextual size (from 0 to N)

    op bmat : GateName -> Mat .

    op _@_ : Gate Gate -> Gate {prec: 31 r-assoc} . -- tenprod
    op _x_ : Gate Ket -> Ket {prec: 31 r-assoc} .   -- matmul

    op _x_ : MetrologyHandler Ket -> Ket {prec: 31 r-assoc strat: (2 1 0)} .
    op _x_ : MetrologyHandler MetrologyHandler -> MetrologyHandler {prec: 31} .
    
    op P : Mat -> ParallelMat .

    op measOp : Mat -> Measurement .
    op normalizer : -> Normalizer .

    vars GN : GateName .
    vars N N1 N2 N3 : Nat .
    vars K K1 K2 : Ket .
    vars BK BK1 BK2 : BasisKet .
    vars BB : BasisBra .
    vars M : Mat .
    vars NL : NatList .
    vars MH1 MH2 : MetrologyHandler .   
    vars C C1 C2 : Complex .

    eq bmat(X)  = (|0><1| + |1><0|) .
    eq bmat(Y)  = (i cos(rzero)) * (- |0><1| + |1><0|) .
    eq bmat(Z)  = |0><0| - |1><1| .
    eq bmat(H)  = cos(1/4 pi) * ((|0><0| + |0><1|) + (|1><0| - |1><1|)) .
    eq bmat(P0) = |0><0| .
    eq bmat(P1) = |1><1| .

    eq bmat(S)  = |0><0| + (i cos(rzero)) * |1><1| .
    eq bmat(SI) = |0><0| - (i cos(rzero)) * |1><1| .     -- Inverse S gate
    eq bmat(T)  = |0><0| + (e^(i (1/4 pi))) * |1><1| .
    eq bmat(TI) = |0><0| + (e^(- i (1/4 pi))) * |1><1| . -- Inverse T gate

    -- N: qubit index (0, 1, 2, ...)
    -- gate mechanisms
    eq    GN (N)            = I(N) @ (bmat(GN) @ I) .
    eq  C GN (N1, N2)       = P0(N1) +    GN (N2)       x P1(N1) .
    eq MC GN ([N1 N2], N3)  = P0(N1) +  C GN (N2, N3)   x P1(N1) .
    eq MC GN ([N1 NL], N2)  = P0(N1) + MC GN ([NL], N2) x P1(N1) .
    
    -- handling I(N) while ensuring the dimensions
    eq (I(N) @ M) x (BK @ K) = BK @ ((I(sd(N, 1)) @ M) x K) .
    eq I(0) @ M              =  M .

    -- handling dimension helper I
    eq ((BK x BB) @ I) x (K1 @ K2) = (((BK x BB) @ I) x K1) @ K2 .
    -- eq ((BK x BB) @ M) x (BK1 @ K) = ((BK x BB) x BK1) @ (M x K) .
    eq (M @ I) x BK = M x BK .
    eq I x K        = K .

    -- parallelism
    -- eq M x ((K1 + K2) @ K) = (P(M) x K1 + P(M) x K2) @ K .
    -- eq P(I(N) @ M) x (BK @ K) = BK @ P((I(sd(N, 1)) @ M) x K) .
    -- ceq (
    --     K1 @ (P(I(N) @ M) x BK1) +
    --     K2 @ (P(I(N) @ M) x BK2)
    -- ) @ K = (
    --     K1 @ BK1 +
    --     K2 @ BK2
    -- ) @ ((I(sd(N, 1)) @ M) x K) .
    -- eq P(I(0) @ M)              =  M .
    
    op nqubit : Ket -> Nat .
    eq nqubit(BK)      = 1 .
    eq nqubit(K1 @ K2) = nqubit(K1) + nqubit(K2) .
    eq nqubit(C * K)   = nqubit(K) .
    eq nqubit(K1 + K2) = nqubit(K1) .

    eq (I(N) @ M) x (K1 @ K2) =
        if nqubit(K1) > N
        then ((I(N) @ M) x K1) @ K2
        else K1 @ ((I(sd(N, nqubit(K1))) @ M) x K2)
        fi .
    
    -- normalization
    eq (MH1 x MH2) x K = MH1 x (MH2 x K) .
    eq normalizer  x K = (cos(rzero) / sqrt(|| K ||^2)) * K . 
    eq measOp(M)   x K = normalizer x (M x K) .
}

mod! QUANTUM-INTERPRETER {
    -- pr(BOOL)
    -- pr(NAT)
    pr(RAT)
    pr(REAL)
    pr(COMPLEX)
    -- pr(NATLIST)
    -- pr(BRAKET)
    pr(GATE)
    [MetrologyHandler < Statement]
    [Mat < Statement]
    [Ket < KetSet]
    [Bool < Flag]

    op _@_ : KetSet KetSet -> KetSet {prec: 71 assoc} .
    op _V_ : KetSet KetSet -> KetSet {prec: 73 assoc comm} .
    
    op _;_ : Statement Statement -> Statement {prec: 71 assoc} .
    op _U_ : Statement Statement -> Statement {prec: 73 assoc comm} .

    op _=_ : KetSet KetSet -> Bool {prec: 81 comm} .
    
    op M : Nat -> Flag .
    op skip : -> Statement .
    op if _ then _ else _ endif : Flag Statement Statement -> Statement {prec: 61} .
    op execute : Statement KetSet -> KetSet .

    vars M1 : Mat .
    vars K : Ket .
    vars KS KS1 KS2 : KetSet .
    vars N : Nat .
    vars STM STM1 STM2 : Statement .
    vars MH : MetrologyHandler .

    eq if M(N) then STM1 else STM2 endif = (
        (P1(N); normalizer; STM1) U 
        (P0(N); normalizer; STM2)
    ) .
    
    eq (KS1 V KS2) @ KS = (KS1 @ KS) V (KS2 @ KS) .
    eq KS @ (KS1 V KS2) = (KS @ KS1) V (KS @ KS2) .

    eq KS V kO = KS .
    eq KS V KS = KS .
    
    eq execute(STM1; STM2, KS)  = execute(STM2, execute(STM1, KS)) .
    eq execute(STM1 U STM2, KS) = execute(STM1, KS) V execute(STM2, KS) .
    eq execute(STM, KS1 V KS2)  = execute(STM, KS1) V execute(STM, KS2) .

    eq execute(M1, K)   = M1 x K .
    eq execute(MH, K)   = MH x K .
    eq execute(skip, K) = K .
}