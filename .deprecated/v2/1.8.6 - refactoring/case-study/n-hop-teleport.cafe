input ../qc.cafe .

mod! N-HOP-TELEPORT {
    pr(PNAT)
    pr(QUANTUM-INTERPRETER)

    op tele-pre-processor : -> Statement .
    op tele-post-processor : -> Statement .
    op tele-program : -> Statement .

    op n-tele : PNat -> KetSet .

    op |psi> : -> Ket .
    ops a b : -> Complex .

    vars K K1 K2 : Ket .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C C1 C2 : Complex .
    vars NzPN : NzPNat .

    eq |psi> = (a * |0> + b * |1>) .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) . -- normalization condition

    eq execute(tele-pre-processor , K) = K @ |0> @ |0> .
    eq execute(tele-post-processor, K) = getQubitByIndex(2, K) .

    eq tele-program = (
        tele-pre-processor;
        H(1);
        C X ( 1 , 2 ) ;  
        C X ( 0 , 1 ) ; 
        H(0) ; 
        if M(1) then X(2) else skip endif;
        if M(0) then Z(2) else skip endif;
        tele-post-processor
    ) .

    eq n-tele(s(0)) = execute(tele-program, |psi>) .
    eq n-tele(s(NzPN)) = execute(
        tele-program,
        n-tele(NzPN)
    ) .
    
    eq C * C1 + C * C2 = C * (C1 + C2) .
}

--> ==========================================================================================
--> Proof of (∀N:PNat) n-tele(N) = |psi>
--> by structural induction on N
--> ------------------------------------------------------------------------------------------
--> Base case:
--> w2s: n-tele(s(0)) = |psi>
open N-HOP-TELEPORT .
    -- w2s
    red n-tele(s(0)) = |psi> .
close
--> ------------------------------------------------------------------------------------------
--> Induction case: 
--> fc : (n):NzPNat
--> IH : n-tele(n) = |psi>
--> w2s: n-tele(s(n)) = |psi>
open N-HOP-TELEPORT .
    -- fc
    op n : -> NzPNat .

    -- IH
    eq [IH] : n-tele(n) = |psi> .

    -- w2s
    red n-tele(s(n)) = |psi> .
close
--> ==========================================================================================
