input ../qc.cafe
set trace off
mod! ENTANGLEMENT-SWAPPING {
    pr(PNAT)
    pr(QUANTUM-INTERPRETER)
    
    op es-pre-processor : -> Statement .
    op es-post-processor : -> Statement .
    op es-program : -> Statement .

    op getKthQubit : Nat Ket -> Ket .
    op removeKthQubit : Nat Ket -> Ket .

    op |input> : -> Ket .

    vars K K1 K2 : Ket .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK BK1 BK2 : BasisKet .
    vars C : Complex .
    vars KS : KetSet .
    vars PN : PNat .
    vars R : Real .
    
    eq |input> = |0> @ |0> @ |0> @ |0> .

    -- eq execute(es-pre-processor, |input>) = |input> .
    -- eq execute(es-post-processor, K) = getKthQubit(0, K) @ getKthQubit(3, K) . -- Entangled state can't be a product state
    -- eq execute(es-post-processor, K) = K .
    -- Best practice: Remove qubits with higher indices first
    eq execute(es-post-processor, K) = removeKthQubit(1, removeKthQubit(2, K)) .

    eq getKthQubit(N, K1 + K2)  = getKthQubit(N, K1) + getKthQubit(N, K2) .
    eq getKthQubit(NzN, BK @ K) = getKthQubit(p NzN, K) .
    eq getKthQubit(0, BK @ K)   = BK .
    eq getKthQubit(0, BK)       = BK .
    eq getKthQubit(N, C * K)    = C * getKthQubit(N, K) .
    
    eq removeKthQubit(N, K1 + K2)  = removeKthQubit(N, K1) + removeKthQubit(N, K2) .
    eq removeKthQubit(NzN, BK @ K) = BK @ removeKthQubit(p NzN, K) .
    eq removeKthQubit(0, BK @ K)   = K .
    eq removeKthQubit(N, C * K)    = C * removeKthQubit(N, K) .

    -- In each EPR source,
    -- both H(a); C X(a, b); |00> |11>
    -- and  H(b); C X(b, a); |01> |10>
    -- are valid only when
    -- qubits at (i = a) and (i = b) are the same
    -- i.e. qubits at (i = a) and (i = b)
    -- can be used as controlled qubits interchangeably

    -- When qubits at (i = a) and (i = b) are different,
    -- qubits at (i = a) and (i = b)
    -- can't be used as controlled qubits interchangeably
    
    -- That is why there are some different diagrams
    -- for entanglement swapping with the |0000> input
    -- (furthermore, some of them won't be correct for other inputs)
    
    -- CORRECT design
    -- Controlled qubits: Alice 0, Charlie 2
    eq es-program = (
        H(0); C X(0, 1);
        H(2); C X(2, 3);
        C X(1, 2); H(1);
        if M(1) then Z(0) else skip endif;
        if M(2) then X(3) else skip endif;
        es-post-processor
    ) .

    -- BAD designs
    -- BAD1
    -- Controlled qubits: Charlie 1, Charlie 2
    -- Charlie's qubits are used as
    -- controlled qubits for generating EPR sources
    -- => The entangled state generated
    -- can't vary based on the input data
    -- from both main and one of the third parties
    -- Thus, it can't "swap" the entanglement
    -- eq es-program = (
    --     H(1); C X(1, 0);
    --     H(2); C X(2, 3);
    --     C X(1, 2); H(1);
    --     if M(1) then Z(0) else skip endif;
    --     if M(2) then X(3) else skip endif;
    --     es-post-processor
    -- ) .

    -- BAD2
    -- Controlled qubits: Alice 0, Bob 3
    -- eq es-program = (
    --     H(0); C X(0, 1);
    --     H(3); C X(3, 2);
    --     C X(1, 2); H(1);
    --     if M(1) then Z(0) else skip endif;
    --     if M(2) then X(3) else skip endif;
    --     es-post-processor
    -- ) .

    -- BAD3
    -- Controlled qubits: Bob 3, Charlie 1
    -- eq es-program = (
    --     H(1); C X(1, 0);
    --     H(3); C X(3, 2);
    --     C X(1, 2); H(1);
    --     if M(1) then Z(0) else skip endif;
    --     if M(2) then X(3) else skip endif;
    --     es-post-processor
    -- ) .

    eq cos(1/4 * pi) * sqrt(2) = cos(rzero) .
    eq sqrt(2 * 1/4) * sqrt(4) = cos(rzero) / cos(1/4 pi) .

    -- implicitly correcting global phase
    eq ((K1 V K2) = K) = (
        (
            (K1 = K) or (K1 = - K)
        ) and (
            (K2 = K) or (K2 = - K)
        )
    ) .
}

--> A demonstration
open ENTANGLEMENT-SWAPPING .
    -- input: |0> @ |0> @ |0> @ |0>
    -- Alice    : i = 0
    -- Charlie  : i = 1, i = 2
    -- Bob      : i = 3
    -- limitation: Alice and Bob have no direct communication
    --             Charlie have direct communication to both Alice and Bob
    -- output: Alice's and Bob's qubits are entangled

    -- w2s
    red execute(es-program, |input>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
close

--> All experiments
--> 00 -> 00 + 11
--> 01 -> 01 + 10
--> 10 -> 00 - 11
--> 11 -> 01 - 10
open ENTANGLEMENT-SWAPPING .
    --> Note: Only input states containing |0> at both (i = 2) and (i = 3) give results of true
    --> ==========================================================================================
    --> 1. 00 -> 00 + 11
    --> 1.1.
    red execute(es-program, |0> @ |0> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> 1.2.
    red execute(es-program, |0> @ |0> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> 1.3.
    red execute(es-program, |0> @ |1> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> 1.4.
    red execute(es-program, |0> @ |1> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> ------------------------------------------------------------------------------------------
    --> 2. 01 -> 01 + 10
    --> 2.1
    red execute(es-program, |0> @ |0> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> 2.2
    red execute(es-program, |0> @ |0> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> 2.3
    red execute(es-program, |0> @ |1> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> 2.4
    red execute(es-program, |0> @ |1> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> ------------------------------------------------------------------------------------------
    --> 3. 10 -> 00 - 11
    --> 3.1
    red execute(es-program, |1> @ |0> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> 3.2
    red execute(es-program, |1> @ |0> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> 3.3
    red execute(es-program, |1> @ |1> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> 3.4
    red execute(es-program, |1> @ |1> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> ------------------------------------------------------------------------------------------
    --> 4. 11 -> 01 - 10
    --> 4.1
    red execute(es-program, |1> @ |0> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> 4.2
    red execute(es-program, |1> @ |0> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> 4.3
    red execute(es-program, |1> @ |1> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> 4.4
    red execute(es-program, |1> @ |1> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> ==========================================================================================
close

--> What happened in the false cases
open ENTANGLEMENT-SWAPPING .
    --> Note: Only input states containing |0> at both (i = 2) and (i = 3) give results of true
    --> ==========================================================================================
    --> 1. 00 -> 00 + 11
    --> 1.1.
    --> F1.2. (10 -> 00 - 11)
    red execute(es-program, |0> @ |0> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> F1.3. (01 -> 01 + 10)
    red execute(es-program, |0> @ |1> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> F1.4. (11 -> 01 - 10)
    red execute(es-program, |0> @ |1> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> ------------------------------------------------------------------------------------------
    --> 2. 01 -> 01 + 10
    --> 2.1.
    --> F2.2. (11 -> 01 - 10)
    red execute(es-program, |0> @ |0> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> F2.3. (00 -> 00 + 11)
    red execute(es-program, |0> @ |1> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> F2.4. (10 -> 00 - 11)
    red execute(es-program, |0> @ |1> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> ------------------------------------------------------------------------------------------
    --> 3. 10 -> 00 - 11
    --> 3.1.
    --> F3.2. (00 -> 00 + 11)
    red execute(es-program, |1> @ |0> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> F3.3. (11 -> 01 - 10)
    red execute(es-program, |1> @ |1> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> F3.4. (01 -> 01 + 10)
    red execute(es-program, |1> @ |1> @ |1> @ |0>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> ------------------------------------------------------------------------------------------
    --> 4. 11 -> 01 - 10
    --> 4.1.
    --> F4.2. (01 -> 01 + 10)
    red execute(es-program, |1> @ |0> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> F4.3. (10 -> 00 - 11)
    red execute(es-program, |1> @ |1> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> F4.4. (00 -> 00 + 11)
    red execute(es-program, |1> @ |1> @ |1> @ |1>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> ==========================================================================================
close

--> Only true cases
open ENTANGLEMENT-SWAPPING .
    --> ==========================================================================================
    --> 1. 00 -> 00 + 11
    red execute(es-program, |0> @ |0> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |0> + |1> @ |1>) .
    --> ------------------------------------------------------------------------------------------
    --> 2. 01 -> 01 + 10
    red execute(es-program, |0> @ |0> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |1> + |1> @ |0>) .
    --> ------------------------------------------------------------------------------------------
    --> 3. 10 -> 00 - 11
    red execute(es-program, |1> @ |0> @ |0> @ |0>) = cos(1/4 pi) * (|0> @ |0> - |1> @ |1>) .
    --> ------------------------------------------------------------------------------------------
    --> 4. 11 -> 01 - 10
    red execute(es-program, |1> @ |0> @ |0> @ |1>) = cos(1/4 pi) * (|0> @ |1> - |1> @ |0>) .
    --> ==========================================================================================
close
