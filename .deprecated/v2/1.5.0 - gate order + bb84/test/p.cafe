input ../qc.cafe .

open QUANTUM-INTERPRETER .
    red H(2) x (
        (
            cos((1/3) pi) * (|1> @ |1>)
            + cos((1/4) pi) * (|0> @ |0>)
        ) @ |0>
    ) .

    red ((|0> x <0|) @ I) x (
        ((cos((1/4 pi)) * |0>) + (cos((1/4 pi)) * |1>)) @ |0>
    ) .

    ops a b : -> Complex .
    red (
        (
            (
                ((a ^*) * (<1| @ (<1| @ <1|))) + ((a ^*) * (<0| @ (<1| @ <1|)))
            )
        ) x (
            (
                ((- b) * |1>) @ (|1> @ |0>)
            ) + ((b * |0>) @ (|1> @ |0>))
        )
    ) .

    red (((|0> x <0|) @ I) x (((b * |1>) + (a * |0>)) @ (|1> @ |1>))) .
    red (cos((1/4 pi)) * 4) .
close

