open GATE .
    ops a b : -> Complex .
    eq (| a |^2) + (| b |^2) = cos(rzero) .
    --> 
    --> Case 1.1
    --> Teleport P0(0), P0(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P0(0))
        x msment-op(P0(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
close
-- eof

open GATE .
