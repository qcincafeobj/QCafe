open GATE .
    ops a b : -> Complex .
    eq (| a |^2) + (| b |^2) = cos(rzero) .
    
    op ketpsi : -> Ket .
    op init : -> Ket .
    op unentnglment : -> Ket .
    op msment : -> Ket .
    op recovery : -> Ket .
    op checker : -> Gate .

    op k : -> Nat .
    var k2 : Nat .

    eq k = 0 .
    
    eq checker = I(k + 2) * (ketpsi x (ketpsi ^+)) .

    eq ketpsi = a * |0> + b * |1> .

    eq init = ketpsi * |0> * |0> .

    eq unentnglment = (
        (H(k))
        x (C(k)X(k + 1))
        x (C(k + 1)X(k + 2))
        x (H(k + 1))
        x init
    ) .

    eq msment = (
        msment-op(P0(k))
        x msment-op(P0(k + 1))
        x unentnglment
    ) .

    eq recovery = (
        (C(k)Z(k + 2))
        x (C(k + 1)X(k + 2))
        x msment
    ) .

    red recovery .
    red checker x recovery .
    red 1 + (((k + 1) + ((k2 + 1) + (k2 + 1))) + ((k + k2) + ((1 + k2) + (k2 + 1)))) .
    red unentnglment .
close

