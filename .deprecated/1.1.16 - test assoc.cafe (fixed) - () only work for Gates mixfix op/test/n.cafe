-- begin
eq qr(init, 0) = { (a | 0 > + b | 1 >, 1.0) } .
ceq qr(init, X) = empMS if X > 0 .
eq index(init) = 0 .
eq label(init) = l1 .

eq c-pre-act(S) = (label(S) = l1) .
ceq qr(pre-act(S), X) = (if X = index(S) + 1 then map(x)(qr(S,index(S)), | 0 > (x) | 0 >) else qr(S,X) fi)  if c-pre-act(S) .
ceq index(pre-act(S)) = index(S) + 1 if c-pre-act(S) .
ceq label(pre-act(S)) = l2 if c-pre-act(S) .
ceq pre-act(S) = S if not c-pre-act(S) .

eq c-teleport-H2(S) = (label(S) = l2) .
ceq qr(teleport-H2(S), X) = (if X = index(S) then Apply the operator I (x) H (x) I to every state contained in qr(S, index(S))
                                                                       else qr(S,X) fi) if c-teleport-H2(S) .
ceq index(teleport-H2(S)) = index(S) if c-teleport-H2(S) .
ceq label(teleport-H2(S)) = l3 if c-teleport-H2(S) .
ceq teleport-H2(S) = S if not c-teleport-H2(S) .

eq c-teleport-CNOT2->3(S) = (label(S) = l3) .
ceq qr(teleport-CNOT2->3(S), X) = (if X = index(S) then Apply I (x) CNOT to each state in qr(S, index(S))
                                                                      else qr(S,X) fi) if c-teleport-CNOT2->3(S) .
ceq index(teleport-CNOT2->3(S)) = index(S) if c-teleport-CNOT2->3(S) .
ceq label(teleport-CNOT2->3(S)) = l4 if c-teleport-CNOT2->3(S) .
ceq teleport-CNOT2->3(S) = S if not c-teleport-CNOT2->3(S) .

eq c-teleport-CNOT1->2(S) = (label(S) = l4) .
ceq qr(teleport-CNOT1->2(S), X) = (if X = index(S) then Apply CNOT (x) I to each state in qr(S, index(S))
                                                                      else qr(S,X) fi) if c-teleport-CNOT1->2(S) .
ceq index(teleport-CNOT1->2(S)) = index(S) if c-teleport-CNOT1->2(S) .
ceq label(teleport-CNOT1->2(S)) = l5 if c-teleport-CNOT1->2(S) .
ceq teleport-CNOT1->2(S) = S if not c-teleport-CNOT1->2(S) .

eq c-teleport-H1(S) = (label(S) = l5) .
ceq qr(teleport-H1(S), X) = (if X = index(S) then Apply H (x) I (x) I to each state in qr(S, index(S))
                                                                       else qr(S,X) fi) if c-teleport-H1(S) .
ceq index(teleport-H1(S)) = index(S) if c-teleport-H1(S) .
ceq label(teleport-H1(S)) = l6 if c-teleport-H1(S) .
ceq teleport-H1(S) = S if not c-teleport-H1(S) .

eq c-teleport-M2Z3(S) = (label(S) = l6) .
ceq qr(teleport-M2Z3(S), X) = (if X = index(S)
                                                   then Measure the second qubit of each state in qr(S, index(S)),
                                                           causing each state to split into two branches.
                                                           If the measurement outcome is 1, apply I (x) 1 (x) Z to the post‑measurement state.
                                                           Otherwise, apply I (x) 0 (x) X to the post‑measurement state.
                                                           (The probabilities are computed appropriately, and each post‑measurement branch is normalized.)
                                                   else qr(S,X) fi)
      if c-teleport-M2Z3(S) .
ceq index(teleport-M2Z3(S)) = index(S) if c-teleport-M2Z3(S) .
ceq label(teleport-M2Z3(S)) = l7 if c-teleport-M2Z3(S) .
ceq teleport-M2Z3(S) = S if not c-teleport-M2Z3(S) .

eq c-teleport-M1X3(S) = (label(S) = l7) .
ceq qr(teleport-M1X3(S), X) = (if X = index(S)
                                                   then Measure the first qubit of each state in qr(S, index(S)),
                                                           causing each state to split into two branches.
                                                           If the measurement outcome is 1, apply <1| (x) Z to the post‑measurement state.
                                                           Otherwise, apply <0| (x) I to the post‑measurement state.
                                                           (The probabilities are computed appropriately, and each post‑measurement branch is normalized.)
                                                   else qr(S,X) fi)
      if c-teleport-M1X3(S) .
ceq index(teleport-M1X3(S)) = index(S) if c-teleport-M1X3(S) .
ceq label(teleport-M1X3(S)) = l8 if c-teleport-M1X3(S) .
ceq teleport-M1X3(S) = S if not c-teleport-M1X3(S) .

eq c-post-act(S) = (label(S) = l8) .
ceq qr(post-act(S), X) = (if X = index(S) then mergeMSP(qr(S)) else qr(S,X) fi) if c-post-act(S) .
ceq index(post-act(S)) = index(S) if c-post-act(S) .
ceq label(post-act(S)) = l1 if c-post-act(S) .
ceq post-act(S) = S if not c-post-act(S) .
-- end

What to formally prove invariant is as follows:
label(S) = l1 implies qr(S,index(S)) = qr(init,0)
which means as follows:
Just after completing the index(S)-th hop, the following always holds:
qr(S,index(S)) = { (a | 0 > + b | 1 >, 1) }

