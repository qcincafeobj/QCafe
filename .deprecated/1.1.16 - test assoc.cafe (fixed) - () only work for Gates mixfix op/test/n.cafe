input ../qc.cafe
open GATE .
    ops a b : -> Complex .
    red ((<1| * (<0| * <0|))) x (|1> * (|1> * |1>)) .
    red ((cos((1/4 pi)) * a) ^+) .
close
eof

set trace off
open GATE .
    ops a b : -> Complex .
    op init-ket : -> Ket .
    op tele-k-to-kplus2 : Nat Ket -> Ket .
    
    -- IH: tele-k-to-kplus2(K, initstate) = checker-kplus2(k) x succ-state .
    -- w2s tele-k-to-kplus2(K + 2, initstate) = checker-kplus2(k + 2) x succ-state .
    -- (tele(|psi> * |0> * |0>) ) * |0> * |0>
    -- (tele(|psi> * |0> * |0>) ) = |...> * |...> * |psi>

    eq tele-k-to-kplus2(K, KET) = (
        (C(K)Z(K + 2))
        x (C(K + 1)X(K + 2))
        x msment-op(P0(K))
        x msment-op(P0(K + 1))
        x (H(K))
        x (C(K)X(K + 1))
        x (C(K + 1)X(K + 2))
        x (H(K + 1))
        x KET
    ) .

    op ketpsi : -> Ket .
    op succ-state : -> Ket .
    eq ketpsi = a * |0> + b * |1> .
    eq | a |^2 + | b |^2 = cos(rzero) .
    eq init-ket = ketpsi * (|0> * |0>) .

    red tele-k-to-kplus2(0, init-ket) .

    op checker-kplus2 : Nat -> Gate .
    eq checker-kplus2(K) = I(K + 2) * (ketpsi x (ketpsi ^+)) .

    eq succ-state = tele-k-to-kplus2(0, init-ket) .

    red checker-kplus2(0) x succ-state .
    red succ-state = checker-kplus2(0) x succ-state .
close

eof

