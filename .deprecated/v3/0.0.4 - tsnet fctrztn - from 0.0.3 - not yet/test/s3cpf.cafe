input ../qc.cafe .
set trace off
set trace on
mod! SHOR-3-QUBIT-CODE-PHASE-FLIP {
    pr(PNAT)
    pr(QUANTUM-INTERPRETER)
    
    op |psi> : -> Ket .
    ops a b : -> Complex .
    eq |psi> = (a * |0> + b * |1>) .
    eq (((a ^*) * a + (b ^*) * b)) = cos(rzero) . -- normalization condition

    op |measQubits> : -> Ket .
    op |plus>       : -> Ket .
    eq |plus>       = H(0) x |0> .
    eq |measQubits> = |plus> @ |plus> .

    vars K K1 K2 : Ket .
    vars N : Nat .
    vars NzN : NzNat .
    vars BK : BasisKet .
    vars C C1 C2 : Complex .
    vars NzPN : NzPNat .
    vars R R1 R2 : Real .

    op s3cpf-simulation          : -> Statement .
    op s3cpf-initializer         : -> Statement .
    op s3cpf-encoder             : -> Statement .
    op s3cpf-noisy-channel       : -> Statement .
    op s3cpf-syndrome-extractor  : -> Statement .
    op s3cpf-meas-and-correction : -> Statement .
    op s3cpf-decoder             : -> Statement .

    eq execute(s3cpf-initializer, K) = K @ |0> @ |0> @ |measQubits> .

    eq s3cpf-encoder = (
        C X(0, 1);
        C X(0, 2);
        H(0);
        H(1);
        H(2)
    ) .
    
    eq s3cpf-syndrome-extractor = (
        C X(3, 0);
        C X(3, 1);
        C X(4, 1);
        C X(4, 2);
        H(3);
        H(4)
    ) .

    eq s3cpf-meas-and-correction = (
        if   M(3) 
        then (if M(4) then Z(1) else Z(0) endif)
        else (if M(4) then Z(2) else skip endif)
        endif
    ) .

    eq execute(s3cpf-decoder, K) = getQubitByIndex(0, K) .

    -- eq s3cpf-simulation = (
    --     s3cpf-initializer;
    --     s3cpf-encoder
    -- ) .
    eq s3cpf-simulation = (
        s3cpf-initializer;
        s3cpf-encoder;
        s3cpf-noisy-channel;
        s3cpf-syndrome-extractor;
        s3cpf-meas-and-correction;
        s3cpf-decoder
    ) .

    op verification-result : -> Bool .
    eq verification-result = (
        execute(s3cpf-simulation, |psi>) = |psi>
    ) .

    eq C * C1 + C * C2 = C * (C1 + C2) .
}

-- open SHOR-3-QUBIT-CODE-PHASE-FLIP .
--     red |measQubits> .
-- close

-- Case 1: Phase-flip error occurs at index 0
open SHOR-3-QUBIT-CODE-PHASE-FLIP .
    -- eq s3cpf-noisy-channel = Z(0) .
    eq s3cpf-noisy-channel = I(0) .
    red verification-result .
close
eof

-- Case 2: Phase-flip error occurs at index 1
open SHOR-3-QUBIT-CODE-PHASE-FLIP .
    eq s3cpf-noisy-channel = Z(1) .
    red verification-result .
close

-- Case 3: Phase-flip error occurs at index 2
open SHOR-3-QUBIT-CODE-PHASE-FLIP .
    eq s3cpf-noisy-channel = Z(2) .
    red verification-result .
close
