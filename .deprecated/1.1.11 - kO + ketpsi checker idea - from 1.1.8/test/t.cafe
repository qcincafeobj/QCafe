input ../qc.cafe .

-- set print mode normal
-- set print mode fancy
-- set print mode tree
-- set print mode s-expr
-- open GATE .
--     red FOO(8)(100) .
--     -- parse FOO(8)(100) .
-- close
-- eof

-- X * rzero = rzero --> X \in {Complex, Real}

open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    -- eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    -- eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .
    
    op ketpsi : -> Ket .
    op checker : -> Gate .
    op succ-state : -> Ket .
    op init-state : -> Ket .
    eq ketpsi = a * |0> + b * |1> .
    eq init-state = ketpsi * (|0> * |0>) .
    eq checker = I(2) * (ketpsi x (ketpsi ^+)) .
    eq succ-state = (
        (C(0)Z(2))
        x (C(1)X(2))
        x (P0(1))
        x (P1(0))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x init-state
    ) .

    -- red ketpsi .
    -- red checker .

    --> 
    --> Case TEMP
    --> Teleport P0(0), P0(1)
    -- red circuit x init-state .
    red succ-state .
    red checker x succ-state .

close

eof

(
    (cos((1/4 pi)) * cos((1/4 pi))) * (
        |1> * (
            |0> * (
                (
                    (((a ^*) * (a * a)) * |0>) + (((b ^*) * (a * b)) * |0>)
                ) + (
                    (((a ^*) * (b * a)) * |1>) + (((b ^*) * (b * b)) * |1>)
                )
            )
        )
    )
):Ket

(
    (
        (cos((1/4 pi)) * (a * cos((1/4 pi)))) * (
            |1> * (|0> * ((((a ^*) * a) * |0>) + (((a ^*) * b) * |1>)))
        )
    ) + (
        (cos((1/4 pi)) * (b * cos((1/4 pi)))) * (
            |1> * (|0> * ((((b ^*) * a) * |0>) + (((b ^*) * b) * |1>)))
        )
    )
):Ket

open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .
    
    --> 
    --> Case 1.1
    --> Teleport P0(0), P0(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P0(0))
        x (P0(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
close
-- eof

open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .

    --> 
    --> Case 1.2
    --> Teleport P0(0), P1(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P0(0))
        x (P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
close
-- eof

open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .
    vars R R1 R2 R3 : Real .
    -- eq R1 * (C1 * (R2 * C2)) = (R1 * R2) * (C1 * C2) .
    -- eq R * C1 + R * C2 = R * (C1 + C2) .
    -- eq (a ^*) * a + (b ^*) * b = cos(rzero) .
    -- eq a * (a ^*) + b * (b ^*) = cos(rzero) .
    -- eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    -- eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    -- eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .
    -- eq cos(R1 pi) * (C * cos(R2 pi)) = (cos(R1 pi) * cos(R2 pi)) * C .
    --> 
    --> Case 1.3
    --> Teleport P1(0), P0(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P1(0))
        x (P0(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
close

open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .

    --> 
    --> Case 1.4
    --> Teleport P1(0), P1(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P1(0))
        x (P1(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
close

open GATE .
    ops a b : -> Complex .

    vars BK2 BK3 BK4 : BasisKet .
    vars KET1 KET2 : Ket .
    vars C1 C2 C3 C4 : Complex .

    eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .

    --> 
    --> Case 2.1
    --> Teleport P0(1), P0(0)
    red (C(0)Z(2))
        x (C(1)X(2))
        x (P0(1))
        x (P0(0))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
close

