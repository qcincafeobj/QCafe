    -- eq R1 * (C1 * (R2 * C2)) = (R1 * R2) * (C1 * C2) .
    -- eq R * C1 + R * C2 = R * (C1 + C2) .
    eq (a ^*) * a + (b ^*) * b = cos(rzero) .
    eq a * (a ^*) + b * (b ^*) = cos(rzero) .
    eq | a |^2 + | b |^2 = cos(rzero) .
    eq (| a |^2 + C1) + (C2 + | b |^2) = cos(rzero) + C1 + C2 .
    -- eq (C1 * (C2 * (C1 * KET1))) = ((C1 * C1) * C2) * KET1 .
    -- eq (C3 * C1) * KET1 + (C3 * C2) * KET2 = C3 * (C1 * KET1 + C2 * KET2) .
    -- eq C1 * (BK3 * (BK4 * BK1)) + C2 * (BK3 * (BK4 * BK2)) = BK3 * (BK4 * (C1 * BK1 + C2 * BK2)) .
    -- eq cos(R1 pi) * (C * cos(R2 pi)) = (cos(R1 pi) * cos(R2 pi)) * C .
    -- eq cos(1/4 pi) = cos(rzero) / sqrt() .
    --> 
    --> Case 1.3
    --> Teleport P1(0), P0(1)
    red (C(0)Z(2))
        x (C(1)X(2))
        x msment-op(P1(0))
        x msment-op(P0(1))
        x (H(0))
        x (C(0)X(1))
        x (C(1)X(2))
        x (H(1))
        x ((a * |0> + b * |1>) * |0> * |0>) .
    
